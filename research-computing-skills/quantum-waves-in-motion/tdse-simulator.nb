Cell[CellGroupData[{

Cell[TextData[StyleBox["Potential Well Set Up",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825138747924304*^9, 
  3.825138756296846*^9}},ExpressionUUID->"95b0d056-1332-40a0-a978-\
fe8765683543"],

Cell[TextData[{
 StyleBox["In this section, we set up the various potential energy functions \
that will influence the electron\[CloseCurlyQuote]s dynamics. Initially, \
several static potentials, including the ",
  FontSize->16],
 StyleBox["square well, quadratic (harmonic) trap, ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["and",
  FontSize->16],
 StyleBox[" step potential",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[", are defined using piecewise functions that depend on the spatial \
coordinate ",
  FontSize->16],
 StyleBox["x",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[". ",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.8251387689574738`*^9, 3.825138799670021*^9}, 
   3.9519933681594677`*^9, {3.952013143610219*^9, 3.9520131477645283`*^9}, {
   3.952013282400321*^9, 3.952013296356921*^9}, {3.9522668526252127`*^9, 
   3.952266858409768*^9}, {3.952276554071414*^9, 3.9522765574736223`*^9}, {
   3.9522922566588697`*^9, 3.952292261678543*^9}, 
   3.95233898254008*^9},ExpressionUUID->"542635fd-67f4-4c04-93fa-\
55c27df6ff19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Square", " ", "well", " ", "potential"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"VSquare", "[", "x_", "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"x", ">=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"L", "/", "2"}], "-", 
           RowBox[{"wellwidth", "/", "2"}], "+", "shift"}], ")"}]}], "&&", 
        RowBox[{"x", "<=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"L", "/", "2"}], "+", 
           RowBox[{"wellwidth", "/", "2"}], "+", "shift"}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"-", "wellheight"}], ",", "\[IndentingNewLine]", "0"}], 
      "]"}]}], ";"}], "\n", 
   StyleBox["\[IndentingNewLine]",
    FontSize->14], 
   StyleBox[
    RowBox[{"(*", 
     RowBox[{"Quadratic", " ", 
      RowBox[{"(", "harmonic", ")"}], " ", "potential"}], "*)"}],
    FontSize->14], 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"VQuadratic", "[", "x_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"x", ">=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"L", "/", "2"}], "-", 
            RowBox[{"wellwidth", "/", "2"}], "+", "shift"}], ")"}]}], "&&", 
         RowBox[{"x", "<=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"L", "/", "2"}], "+", 
            RowBox[{"wellwidth", "/", "2"}], "+", "shift"}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"wellheight", "*", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", 
              RowBox[{"L", "/", "2"}]}], ")"}], "^", "2"}], "/", "10000"}]}], 
         "-", "wellheight"}], ",", "\[IndentingNewLine]", "0"}], "]"}]}], 
     ";"}],
    FontSize->14], 
   StyleBox["\[IndentingNewLine]",
    FontSize->14], 
   StyleBox["\[IndentingNewLine]",
    FontSize->14], 
   StyleBox[
    RowBox[{"(*", 
     RowBox[{"Step", " ", "potential"}], "*)"}],
    FontSize->14], 
   StyleBox["\[IndentingNewLine]",
    FontSize->14], 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"VStep", "[", "x_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"x", ">=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"L", "/", "2"}], "-", 
            RowBox[{"wellwidth", "/", "2"}], "+", "shift"}], ")"}]}], "&&", 
         RowBox[{"x", "<=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"L", "/", "2"}], "+", 
            RowBox[{"wellwidth", "/", "2"}], "+", "shift"}], ")"}]}]}], ",", 
        "\[IndentingNewLine]", "wellheight", ",", "\[IndentingNewLine]", 
        "0"}], "]"}]}], ";"}],
    FontSize->14], 
   StyleBox["\[IndentingNewLine]",
    FontSize->14], 
   StyleBox["\[IndentingNewLine]",
    FontSize->14], 
   StyleBox["\n",
    FontSize->14], 
   StyleBox[
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Function", " ", "to", " ", "select", " ", "the", " ", "appropriate", " ",
        "potential", " ", "based", " ", "on", " ", "a", " ", "given", " ", 
       RowBox[{"type", ".", "\[IndentingNewLine]", 
        RowBox[{"Options", ":", " ", "\"\<free\>\""}]}]}], ",", 
      " ", "\"\<square\>\"", ",", " ", "\"\<quadratic\>\"", ",", " ", 
      RowBox[{"and", " ", 
       RowBox[{"\"\<step\>\"", "."}]}]}], "*)"}],
    FontSize->14], 
   StyleBox["\[IndentingNewLine]",
    FontSize->14], 
   RowBox[{
    StyleBox[
     RowBox[{"choosePotential", "[", "ptype_", "]"}],
     FontSize->14], 
    StyleBox[":=",
     FontSize->14], 
    RowBox[{
     StyleBox["Module",
      FontSize->14], 
     StyleBox["[",
      FontSize->14], 
     RowBox[{
      StyleBox[
       RowBox[{"{", "V", "}"}],
       FontSize->14], 
      StyleBox[",",
       FontSize->14], 
      StyleBox["\[IndentingNewLine]",
       FontSize->14], 
      RowBox[{
       StyleBox[
        RowBox[{"V", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Length", "[", "x", "]"}]}], "]"}]}],
        FontSize->14], 
       StyleBox[";",
        FontSize->14], 
       StyleBox["     ",
        FontSize->14], 
       StyleBox[
        RowBox[{"(*", 
         RowBox[{"Initialise", " ", "the", " ", "potential", " ", "array"}], 
         "*)"}],
        FontSize->14], 
       StyleBox["\[IndentingNewLine]",
        FontSize->14], 
       StyleBox["\[IndentingNewLine]",
        FontSize->14], 
       StyleBox[
        RowBox[{"Switch", "[", 
         RowBox[{
         "ptype", ",", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "\"\<free\>\"", ",", "\[IndentingNewLine]", 
          "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"For", " ", "a", " ", "free", " ", "particle"}], ",", " ", 
            RowBox[{"leave", " ", "V", " ", "unchanged"}]}], "*)"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "\"\<square\>\"", ",", "\[IndentingNewLine]",
           "\t", 
          RowBox[{
           RowBox[{"V", "=", 
            RowBox[{"Map", "[", 
             RowBox[{"VSquare", ",", "x"}], "]"}]}], ";"}], ",", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", "\"\<quadratic\>\"", ",",
           "\[IndentingNewLine]", "\t", 
          RowBox[{
           RowBox[{"V", "=", 
            RowBox[{"Map", "[", 
             RowBox[{"VQuadratic", ",", "x"}], "]"}]}], ";"}], ",", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "\"\<step\>\"", ",", "\[IndentingNewLine]", 
          "\t", 
          RowBox[{
           RowBox[{"V", "=", 
            RowBox[{"Map", "[", 
             RowBox[{"VStep", ",", "x"}], "]"}]}], ";"}]}], 
         "\[IndentingNewLine]", "\[IndentingNewLine]", "        ", "]"}],
        FontSize->14], 
       StyleBox[";",
        FontSize->14], 
       StyleBox["\[IndentingNewLine]",
        FontSize->14], 
       RowBox[{"Return", "[", "V", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.8254249089321938`*^9, 3.8254249421671953`*^9}, 
   3.825437616244816*^9, {3.825590681970858*^9, 3.825590685104061*^9}, {
   3.825591425899066*^9, 3.82559142627523*^9}, {3.8255916750100718`*^9, 
   3.8255916839418*^9}, {3.825654802036907*^9, 3.825654824838181*^9}, {
   3.8256593411799183`*^9, 3.825659372523469*^9}, {3.951984149357397*^9, 
   3.951984150180468*^9}, {3.9519877010349617`*^9, 3.951987723012124*^9}, 
   3.9520132726655073`*^9, 3.9520133303616743`*^9, {3.952020272284458*^9, 
   3.95202027712337*^9}, {3.95202065474841*^9, 3.952020672576167*^9}, 
   3.952274255552321*^9, {3.952291833805344*^9, 3.952291842498485*^9}, {
   3.952292180670094*^9, 3.9522922392063*^9}, {3.95229244087912*^9, 
   3.952292443693502*^9}, {3.9523458720777607`*^9, 3.952345901838119*^9}, {
   3.952345958393935*^9, 3.952346078670236*^9}, {3.952351813841535*^9, 
   3.9523518446733923`*^9}, {3.952434242674713*^9, 3.952434271561406*^9}},
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->"In[32]:=",ExpressionUUID->"0ec5d4e0-f7e6-4c3a-a529-0d0948f5ac01"],

Cell[TextData[{
 "Define a ",
 StyleBox["square potential",
  FontWeight->"Bold"],
 " for illustration:"
}], "Text",
 CellChangeTimes->{{3.8255914389184723`*^9, 
  3.825591454620867*^9}},ExpressionUUID->"df998389-91d0-4366-a20f-\
f93cbee8185e"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"V", " ", "=", 
    RowBox[{"choosePotential", "[", "\"\<square\>\"", "]"}]}], ";"}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.825424775590109*^9, 3.825424779491115*^9}, 
   3.825435870390258*^9, 3.825437302594558*^9, 3.82543767248982*^9, {
   3.825590765422205*^9, 3.825590766323636*^9}, 3.95219606711167*^9, {
   3.952433753952757*^9, 3.952433754240164*^9}, {3.952433907389246*^9, 
