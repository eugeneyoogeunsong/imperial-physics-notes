Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
    "Set", " ", "up", " ", "the", " ", "potential", " ", "parameters"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"wellheight", "=", "80"}], ";"}], "                 ", 
    RowBox[{"(*", 
     RowBox[{
     "Peak", " ", "amplitude", " ", "of", " ", "the", " ", "potential", " ", 
      "in", " ", "eV"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"wellwidth", "=", "100"}], ";"}], "                 ", 
    RowBox[{"(*", 
     RowBox[{
     "Width", " ", "of", " ", "the", " ", "potential", " ", "feature", " ", 
      "in", " ", "nm"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"potential", "=", "\"\<step\>\""}], ";"}], "    ", "      ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Select", " ", "the", " ", "type", " ", "of", " ", 
       RowBox[{"potential", ":", " ", "\"\<free\>\""}]}], ",", 
      " ", "\"\<square\>\"", ",", " ", "\"\<quadratic\>\"", ",", " ", 
      RowBox[{"and", " ", "\"\<step\>\""}]}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"shift", "=", "0"}], ";"}], "                      ", "  ", "  ",
     "    ", 
    RowBox[{"(*", 
     RowBox[{
     "Displacement", " ", "of", " ", "the", " ", "potential", " ", "in", " ", 
      "nm", " ", "relative", " ", "to", " ", "the", " ", "center", " ", "of", 
      " ", "the", " ", "simulation", " ", "domain"}], "*)"}]}]}],
  FontSize->14]], "Input",
