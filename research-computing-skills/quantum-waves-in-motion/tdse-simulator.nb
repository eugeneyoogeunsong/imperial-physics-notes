Cell[CellGroupData[{

Cell[TextData[StyleBox["4. Conclusion",
 FontSize->36,
 FontWeight->"Bold"]], "Chapter",
 CellChangeTimes->{{3.8256065338569736`*^9, 3.8256065387347116`*^9}, {
  3.9522755905495996`*^9, 3.952275590734675*^9}, {3.952275959241591*^9, 
  3.952275959345614*^9}},ExpressionUUID->"a0401d60-bd27-4572-9a72-\
9ae1b31df204"],

Cell[TextData[StyleBox["Robust Numerical Framework:",
 FontWeight->"Bold"]], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.95199137381304*^9, 3.951991382952771*^9}, 
   3.952010169345635*^9, {3.952274698760338*^9, 3.952274700338166*^9}},
 FontSize->18,ExpressionUUID->"a98ac67d-06f0-4ba5-b54f-e78be19fd238"],

Cell[TextData[{
 StyleBox["\t\[Bullet]\tA finite-difference time-domain (FDTD) method has \
been successfully implemented using the ",
  FontSize->16],
 StyleBox["Euler scheme",
  FontSize->16],
 StyleBox[" to solve the time-dependent Schr\[ODoubleDot]dinger\n\t\tequation \
(TDSE). This straightforward approach provides a reliable foundation for \
exploring quantum dynamics.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.952010263164678*^9, 3.952010264115017*^9}, {
  3.952274702576255*^9, 3.952274710858861*^9}, {3.952275203710273*^9, 
  3.952275215398134*^9}},
 FontSize->16,ExpressionUUID->"615708bb-5ba2-4104-9130-238476f81d29"],

Cell[TextData[StyleBox["Solid Foundational Setup:",
 FontWeight->"Bold"]], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.95199137381304*^9, 3.951991382952771*^9}, 
   3.952010169345635*^9, {3.952010213138834*^9, 3.952010214436563*^9}},
 FontSize->18,ExpressionUUID->"bb869fe0-b310-47e4-820b-28a52f47a9c0"],

Cell[TextData[StyleBox["\t\[Bullet]\tEssential physical constants are defined \
and a discretised spatial grid is constructed with careful unit management, \
ensuring that the simulation \n\t\taccurately represents the underlying \
quantum system.",
 FontSize->16]], "Text",
 CellChangeTimes->{{3.9520102738110247`*^9, 3.952010274704659*^9}, {
  3.952010442572453*^9, 3.952010442636362*^9}, {3.9522747380283833`*^9, 
  3.952274747703973*^9}},
 FontSize->16,ExpressionUUID->"869a3b3d-15f7-4b8e-adb8-3d86be6768df"],

Cell[TextData[StyleBox["Flexible Potential Landscape:",
 FontWeight->"Bold"]], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.95199137381304*^9, 3.951991382952771*^9}, 
   3.952010169345635*^9, 3.952010219212367*^9, {3.95227475615527*^9, 
   3.95227475816292*^9}},
 FontSize->18,ExpressionUUID->"92b4d748-4e2f-4454-b4ec-c630835f70cc"],

Cell["\<\
          \[Bullet]\tA modular potential framework has been developed, \
enabling easy switching between various potential types\[LongDash]such as \
free, square, quadratic (harmonic),
\t\tand step potentials\[LongDash]so that different quantum scenarios can be \
explored seamlessly.\
\>", "Text",
 CellChangeTimes->{{3.952010286419623*^9, 3.952010323557185*^9}, {
  3.952010398478014*^9, 3.952010404689846*^9}, {3.952274763423997*^9, 
  3.952274770558823*^9}, {3.952274971342785*^9, 3.952274974073337*^9}},
 FontSize->16,ExpressionUUID->"fb6f400c-fb0c-4a0c-8459-e1dc29eb6539"],

Cell[TextData[StyleBox["Accurate Time Propagation:",
 FontWeight->"Bold"]], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.95199137381304*^9, 3.951991382952771*^9}, 
   3.952010169345635*^9, 3.952010225015229*^9},
 FontSize->18,ExpressionUUID->"91408701-8ddf-4efc-a338-d68494b15176"],

Cell[TextData[{
 "          \[Bullet]\t ",
 StyleBox["The Euler method is applied to propagate the wavefunction over \
time. The initial state, defined as a normalised Gaussian wave packet with \
embedded\n\t\tphase (via cosine and sine modulation), effectively captures \
both spatial localisation and momentum characteristics.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.952010309394018*^9, 3.9520103367185802`*^9}, {
  3.952010416761374*^9, 3.9520104175650053`*^9}, {3.9520105731451263`*^9, 
  3.952010573617016*^9}, {3.952274780216913*^9, 3.95227479149823*^9}, {
  3.9522749482348213`*^9, 
  3.952274952399126*^9}},ExpressionUUID->"4bea307e-6936-4b05-bfce-\
7cde42774c6e"],

Cell[TextData[StyleBox["Interactive Exploration:",
 FontWeight->"Bold"]], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.95199137381304*^9, 3.951991382952771*^9}, 
   3.952010169345635*^9, 3.952010243196121*^9, {3.952010524527706*^9, 
   3.9520105375543823`*^9}, 3.952010577162709*^9, {3.952274842110817*^9, 
   3.952274846217779*^9}, {3.952275083183057*^9, 3.952275083451756*^9}},
 FontSize->18,ExpressionUUID->"55f67d04-60be-4746-92f7-5bb74ee80f6b"],

Cell[TextData[{
 "    ",
 StyleBox["     ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]\tAn interactive simulation dashboard has been \
implemented, enabling real-time adjustments of parameters (e.g., time step, \
potential depth, wavepacket\n         \t\twidth). This interactivity enhances \
user engagement and deepens the understanding of how different physical \
settings influence quantum dynamics.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.952010458607305*^9, 3.952010501823351*^9}, {
  3.952274799833036*^9, 3.952274813699161*^9}, {3.952274928831069*^9, 
  3.952274938045745*^9}, {3.952275044160083*^9, 3.952275054033628*^9}, {
  3.952275085397875*^9, 
  3.952275088174316*^9}},ExpressionUUID->"da6cc482-aa4e-47c3-9ba1-\
7df9cbb7758b"],

Cell[TextData[StyleBox["Insightful Visualisations:",
 FontWeight->"Bold"]], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.95199137381304*^9, 3.951991382952771*^9}, 
   3.952010169345635*^9, 3.952010234411943*^9, {3.952010450327386*^9, 
   3.952010450405088*^9}},
 FontSize->18,ExpressionUUID->"18a68352-d395-4377-8bd7-441e50446fec"],

Cell[TextData[{
 "          \[Bullet]\t ",
 StyleBox["Dynamic evolution plots and animations illustrate key quantum \
phenomena such as tunneling, reflection, and dispersion. Advanced \
visualisation tools\[LongDash]\n\t\tsuch as phase-space analysis using the \
Wigner function and frequency spectrum analysis via the ",
  FontSize->16],
 StyleBox["Periodogram",
  FontSize->16,
  FontSlant->"Italic"],
 StyleBox["\[LongDash]offer deeper insights into momentum and\n\t\tenergy \
distributions.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.952010458607305*^9, 3.952010501823351*^9}, {
  3.952274799833036*^9, 3.952274813699161*^9}, {3.952274928831069*^9, 
  3.952274938045745*^9}, {3.952275044160083*^9, 
  3.952275050199151*^9}},ExpressionUUID->"5db33619-7c5b-4877-999f-\
cc7144281461"],

Cell[TextData[StyleBox["Future Extensions:",
 FontWeight->"Bold"]], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.95199137381304*^9, 3.951991382952771*^9}, 
   3.952010169345635*^9, 3.952010238999764*^9, {3.952010509382696*^9, 
   3.9520105175465393`*^9}, {3.952010597923098*^9, 3.952010610498865*^9}, {
   3.95227482738732*^9, 3.9522748351055403`*^9}, {3.952274989238056*^9, 
   3.952274999389861*^9}, 3.9522750954644938`*^9},
 FontSize->18,ExpressionUUID->"bd45b64e-c1aa-47e3-a081-9d45b466192e"],

Cell[TextData[{
 "    ",
 StyleBox["     ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[Bullet]\tFuture work may involve exploring more complex \
time-dependent potentials and extending the simulation to multiple \
dimensions, thereby broadening\n         \t\tthe solver\[CloseCurlyQuote]s \
applicability and educational value.\n\nAll in all, this project not only \
reinforces the theoretical foundations of the TDSE but also provides an \
intuitive, hands-on approach to understanding complex quantum dynamics \
through practical simulation and visualisation.      ",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.952010458607305*^9, 3.952010501823351*^9}, {
  3.952274799833036*^9, 3.952274813699161*^9}, {3.952274928831069*^9, 
  3.952274938045745*^9}, {3.952275044160083*^9, 3.952275054033628*^9}, {
  3.952275085397875*^9, 
  3.952275114927577*^9}},ExpressionUUID->"589f39eb-cc4f-4e46-bd77-\
5a82793a3182"],

