Cell[TextData[{
 "Note: Although the ",
 StyleBox["RK4 method can offer enhanced accuracy and stability, our final \
implementation uses the Euler method for simplicity.",
  FontWeight->"Bold"],
 " The RK4 code above is provided as a demonstration of an alternative, more \
accurate technique."
}], "Text",
 CellChangeTimes->{
  3.9522796081904907`*^9, {3.952593968573574*^9, 3.952593973458552*^9}, {
   3.952594003566557*^9, 
   3.952594003706891*^9}},ExpressionUUID->"92115c51-95c7-41de-a511-\
9fab70f7e41a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Creation of the Time Evolution Plots",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.8251485371976767`*^9, 3.82514854919247*^9}, {
  3.952011747312974*^9, 3.952011747971097*^9}, {3.952011795182362*^9, 
  3.952011796955278*^9}, {3.9522793139754353`*^9, 3.952279325505559*^9}, {
  3.952279547376844*^9, 
  3.9522795938555183`*^9}},ExpressionUUID->"1464c06b-6820-474d-8c63-\
e53abe3a1882"],

Cell[TextData[{
 StyleBox["In this section, the ",
  FontSize->16],
 StyleBox["generateEvolutionPlots",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" function is used to create a series of plots that capture the \
time evolution of the wavefunction and the potential landscape. The function \
processes the saved frames from the ",
  FontSize->16],
 StyleBox["timeEvolutionEuler",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" function, generating plots that show both the real and imaginary \
components of the wavefunction and overlaying the potential for comparison. \
These individual plots are then arranged into a sequence (typically using ",
  FontSize->16],
 StyleBox["GraphicsColumn",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" or a similar function) to create a smooth animation. The \
resulting animation provides visual insight into quantum phenomena such as \
tunneling, reflection, and dispersion, helping to bridge the gap between \
abstract numerical results and physical intuition.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.825587580900291*^9, 3.825587615655827*^9}, 
   3.951994761701128*^9, 3.952020233920149*^9, 3.952023030208508*^9, {
   3.952276449033038*^9, 
   3.952276449518188*^9}},ExpressionUUID->"c2dc2746-f1c2-4e9e-84ba-\
41ca78266452"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
    "generateEvolutionPlots", " ", "constructs", " ", "a", " ", "series", " ",
      "of", " ", "plots", " ", "that", " ", "display", " ", "the", " ", 
     "wavefunction", " ", 
     RowBox[{"evolution", "."}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"generateEvolutionPlots", "[", 
     RowBox[{"result_", ",", "V_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"times", ",", "RtFrames", ",", "ItFrames", ",", "PtFrames"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Unpack", " ", "the", " ", "saved", " ", "data", " ", "from", " ", 
        "the", " ", "time", " ", "evolution"}], "*)"}], "\[IndentingNewLine]",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"times", "=", 
        RowBox[{"result", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "       ", 
       RowBox[{"(*", 
        RowBox[{"List", " ", "of", " ", "time", " ", "stamps"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"RtFrames", "=", 
        RowBox[{"result", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "Real", " ", "part", " ", "snapshots", " ", "at", " ", "each", " ", 
         "saved", " ", "frame"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ItFrames", "=", 
        RowBox[{"result", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "Imaginary", " ", "part", " ", "snapshots", " ", "at", " ", "each", " ",
          "saved", " ", "frame"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"PtFrames", "=", 
        RowBox[{"result", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "Probability", " ", "density", " ", "snapshots", " ", "at", " ", 
         "each", " ", "saved", " ", "frame"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Create", " ", "a", " ", "table", " ", "of", " ", "plots", " ", "for",
          " ", "each", " ", "saved", " ", "frame"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"evolutionPlots", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"GraphicsColumn", "[", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
              "Combined", " ", "plot", " ", "of", " ", "wavefunction", " ", 
               "components", " ", "and", " ", "potential"}], "*)"}], 
             RowBox[{
              RowBox[{
               RowBox[{"ResourceFunction", "[", "\"\<CombinePlots\>\"", "]"}],
                "[", 
               RowBox[{
                RowBox[{"ListLinePlot", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", " ", 
                    RowBox[{"ItFrames", "[", 
                    RowBox[{"[", "frameNo", "]"}], "]"}]}], "}"}], "]"}], ",", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{"x", ",", " ", 
                    RowBox[{"RtFrames", "[", 
                    RowBox[{"[", "frameNo", "]"}], "]"}]}], "}"}], "]"}]}], 
                   "}"}], ",", 
                  RowBox[{"PlotRange", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "L"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "0.25"}], ",", "0.25"}], "}"}]}], "}"}]}], ",",
                   " ", 
                  RowBox[{
                  "PlotLabel", 
                   "\[Rule]", "\"\<Wavefunction and Potential\>\""}], ",", 
                  " ", 
                  RowBox[{"FrameLabel", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{"\"\<Position x [nm]\>\"", ",", 
                    " ", "\"\<Wavefunction Amplitude\>\""}], "}"}]}], ",", 
                  " ", 
                  RowBox[{"PlotStyle", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{"Blue", ",", " ", "Orange"}], "}"}]}], ",", " ", 
                  RowBox[{"ImageSize", "\[Rule]", "Automatic"}], ",", 
                  RowBox[{"Frame", "\[Rule]", "True"}], ",", " ", 
                  RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", " ", 
                  RowBox[{"LabelStyle", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"FontSize", "\[Rule]", "14"}], ",", 
                    RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
                    " ", "Black", ",", "Bold"}], "}"}]}], ",", " ", 
                  RowBox[{"PlotLegends", "\[Rule]", 
                   RowBox[{"Placed", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"\"\<\[InvisiblePrefixScriptBase]\!\(\*\
SubscriptBox[\(\[Phi]\), \(I\)]\)(t)\>\"", ",", 
                    " ", "\"\<\!\(\*SubscriptBox[\(\[Phi]\), \
\(R\)]\)(t)\>\""}], "}"}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"Left", ",", " ", "Top"}], "}"}]}], "]"}]}]}], 
                 "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"ListLinePlot", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", 
                   RowBox[{"{", 
                    RowBox[{"x", ",", " ", "V"}], "}"}], "]"}], ",", "  ", 
                  RowBox[{"PlotStyle", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{"Red", ",", " ", "Dotted"}], "}"}]}], ",", " ", 
                  RowBox[{"ImageSize", "\[Rule]", "Automatic"}], ",", 
                  RowBox[{"BaselinePosition", "\[Rule]", "Axis"}], ",", " ", 
                  RowBox[{"PlotLegends", "\[Rule]", 
                   RowBox[{"Placed", "[", 
                    RowBox[{
                    RowBox[{
                    "{", "\"\<\[InvisiblePrefixScriptBase]V(x)\>\"", "}"}], ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", 
                  RowBox[{"Frame", "\[Rule]", "True"}], ",", 
                  RowBox[{"FrameStyle", "\[Rule]", "Red"}], ",", " ", 
                  RowBox[{"PlotRange", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Min", "[", "V", "]"}], "-", "10"}], ",", 
                    RowBox[{
                    RowBox[{"Max", "[", "V", "]"}], "+", "10"}]}], "}"}]}], ",",
                   " ", 
                  RowBox[{"FrameLabel", "\[Rule]", 
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<Position x [nm]\>\"", ",", 
                    " ", "\"\<Potential V [eV]\>\""}], "}"}]}], ",", "  ", 
                  RowBox[{"LabelStyle", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"FontSize", "\[Rule]", "14"}], ",", 
                    RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
                    " ", "Black", ",", "Bold"}], "}"}]}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"\"\<AxesSides\>\"", "\[Rule]", "\"\<TwoY\>\""}]}], 
               "]"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"ResourceFunction", "[", "\"\<CombinePlots\>\"", "]"}],
                "[", 
               RowBox[{
                RowBox[{"ListLinePlot", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", 
                   RowBox[{"{", 
                    RowBox[{"x", ",", 
                    RowBox[{"PtFrames", "[", 
                    RowBox[{"[", "frameNo", "]"}], "]"}]}], "}"}], "]"}], ",",
                   "  ", 
                  RowBox[{"PlotRange", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "L"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", 
                    RowBox[{
                    RowBox[{"Max", "[", "PtFrames", "]"}], "+", "0.01"}]}], 
                    "}"}]}], "}"}]}], ",", " ", 
                  RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
                  RowBox[{
                  "PlotLabel", 
                   "\[Rule]", "\"\<Probability Distribution and \
Potential\>\""}], ",", " ", 
                  RowBox[{"FrameLabel", "\[Rule]", 
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<Position x [nm]\>\"", ",", 
                    " ", "\"\<Probability P \>\""}], "}"}]}], ",", " ", 
                  RowBox[{"ImageSize", "\[Rule]", "Automatic"}], ",", 
                  RowBox[{"Frame", "\[Rule]", "True"}], ",", " ", 
                  RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", " ", 
                  RowBox[{"LabelStyle", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"FontSize", "\[Rule]", "15"}], ",", 
                    RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
                    "Black", ",", "Bold"}], "}"}]}], ",", 
                  RowBox[{"PlotLegends", "\[Rule]", 
                   RowBox[{"Placed", "[", 
                    RowBox[{
                    RowBox[{
                    "{", "\"\<\[InvisiblePrefixScriptBase]P(x)\>\"", "}"}], ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{"Left", ",", " ", "Top"}], "}"}]}], "]"}]}]}], 
                 "]"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
                RowBox[{"ListLinePlot", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", 
                   RowBox[{"{", 
                    RowBox[{"x", ",", " ", "V"}], "}"}], "]"}], ",", "  ", 
                  RowBox[{"PlotStyle", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{"Red", ",", " ", "Dotted"}], "}"}]}], ",", " ", 
                  RowBox[{"ImageSize", "\[Rule]", "Automatic"}], ",", 
                  RowBox[{"BaselinePosition", "\[Rule]", "Axis"}], ",", " ", 
                  RowBox[{"PlotLegends", "\[Rule]", 
                   RowBox[{"Placed", "[", 
                    RowBox[{
                    RowBox[{
                    "{", "\"\<\[InvisiblePrefixScriptBase]V(x)\>\"", "}"}], ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", 
                  RowBox[{"Frame", "\[Rule]", "True"}], ",", 
                  RowBox[{"FrameStyle", "\[Rule]", "Red"}], ",", " ", 
                  RowBox[{"PlotRange", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Min", "[", "V", "]"}], "-", "10"}], ",", 
                    RowBox[{
                    RowBox[{"Max", "[", "V", "]"}], "+", "10"}]}], "}"}]}], ",",
                   " ", 
                  RowBox[{"FrameLabel", "\[Rule]", 
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<Position x [nm]\>\"", ",", 
                    " ", "\"\<Potential V [eV]\>\""}], "}"}]}], ",", " ", 
                  RowBox[{"LabelStyle", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"FontSize", "\[Rule]", "14"}], ",", 
                    RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", 
                    "Black", ",", "Bold"}], "}"}]}]}], "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"\"\<AxesSides\>\"", "\[Rule]", "\"\<TwoY\>\""}]}], 
               "]"}]}], "\[IndentingNewLine]", "}"}], ",", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"ImageSize", "->", "Large"}], ",", 
            RowBox[{"Epilog", "->", 
             RowBox[{"Inset", "[", 
              RowBox[{
               RowBox[{"Framed", "[", 
                RowBox[{"Text", "[", 
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"\"\<Elapsed Time = \>\"", "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"NumberForm", "[", 
                    RowBox[{
                    RowBox[{"times", "[", 
                    RowBox[{"[", "frameNo", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "]"}], 
                    "<>", "\"\< s\>\""}], ",", 
                   RowBox[{"FontFamily", "->", "\"\<Arial\>\""}], ",", 
                   RowBox[{"FontSize", "->", "12"}], ",", 
                   RowBox[{"FontColor", "->", "Black"}], ",", "Bold"}], "]"}],
                  "]"}], "]"}], ",", 
               RowBox[{"Scaled", "[", 
                RowBox[{"{", 
                 RowBox[{"0.75", ",", "0.08"}], "}"}], "]"}]}], "]"}]}]}], 
           "\n", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"frameNo", ",", "1", ",", 
            RowBox[{"Floor", "[", 
             RowBox[{"ntimestep", "/", "framestep"}], "]"}], ",", "1"}], 
           "}"}]}], "\n", "]"}]}], ";", "\[IndentingNewLine]", "\n", 
       RowBox[{"(*", 
        RowBox[{
        "Return", " ", "the", " ", "list", " ", "of", " ", "evolution", " ", 
         "plots"}], "*)"}], "\[IndentingNewLine]", "evolutionPlots"}]}], 
     "\[IndentingNewLine]", "]"}]}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.82542210701867*^9, 3.825422107669264*^9}, {
   3.825524141494266*^9, 3.825524159282153*^9}, {3.825586845391089*^9, 
