Cell[CellGroupData[{

Cell[TextData[StyleBox["Visualisation of the Initial Conditions",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.82514688689818*^9, 3.825146897189208*^9}, {
  3.952011710325086*^9, 3.952011713205493*^9}, {3.9520118535602293`*^9, 
  3.952011855859647*^9}},ExpressionUUID->"29dfaa2b-5abf-46ff-b582-\
6d1e896367df"],

Cell[TextData[{
 StyleBox["This section presents a comprehensive visual representation of the \
system\[CloseCurlyQuote]s initial state. The plots showcase both the \
wavefunction\[CloseCurlyQuote]s components and the applied potential, serving \
as a critical checkpoint before time evolution is initiated. The first plot \
displays the separate real and imaginary parts of the initial wavefunction. \
These components, derived from a ",
  FontSize->16],
 StyleBox["Gaussian envelope ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["modulated by trigonometric functions, confirm the spatial \
localisation and phase properties of the electron\[CloseCurlyQuote]s state. \
The potential energy profile is superimposed on the wavefunction plot using a \
contrasting color and line style. This dual-axis visualisation enables a \
direct comparison between the wavefunction and the potential, ensuring that \
the potential is correctly defined over the spatial domain.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.8251471033253813`*^9, 3.825147143870367*^9}, {
  3.825318076544272*^9, 3.825318077380114*^9}, {3.9520221453186502`*^9, 
  3.952022154569083*^9}, {3.952273920933002*^9, 3.9522739215695753`*^9}, {
  3.952275329414152*^9, 
  3.952275330546897*^9}},ExpressionUUID->"547c4f91-addd-41ce-9275-\
1200012d7074"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"ResourceFunction", "[", "\"\<CombinePlots\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "I0"}], "}"}], "]"}], ",", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", "R0"}], "}"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
      RowBox[{
      "PlotLabel", "\[Rule]", "\"\<Initial Wavefunction and Potential\>\""}], 
      ",", " ", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Position x [nm]\>\"", ",", 
         " ", "\"\<Wavefunction P \>\""}], "}"}]}], ",", " ", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", " ", "Orange"}], "}"}]}], ",", " ", 
      RowBox[{"ImageSize", "\[Rule]", "600"}], ",", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", " ", 
      RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", " ", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FontSize", "\[Rule]", "15"}], ",", 
         RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", " ", 
         "Black", ",", "Bold"}], "}"}]}], ",", " ", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"{", 
          
          RowBox[{"\"\<\[InvisiblePrefixScriptBase]\!\(\*SubscriptBox[\(\[Phi]\
\), \(I\)]\)(t=0)\>\"", ",", 
           " ", "\"\<\!\(\*SubscriptBox[\(\[Phi]\), \(R\)]\)(t=0)\>\""}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Left", ",", " ", "Top"}], "}"}]}], "]"}]}]}], "]"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "V"}], "}"}], "]"}], ",", "  ", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Red", ",", " ", "Dotted"}], "}"}]}], ",", " ", 
      RowBox[{"ImageSize", "\[Rule]", "600"}], ",", 
      RowBox[{"BaselinePosition", "\[Rule]", "Axis"}], ",", " ", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"{", "\"\<\[InvisiblePrefixScriptBase]V(x)\>\"", "}"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"Right", ",", " ", "Top"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"Frame", "\[Rule]", "True"}], ",", 
      RowBox[{"FrameStyle", "\[Rule]", "Red"}], ",", " ", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", "V", "]"}], "-", "10"}], ",", 
         RowBox[{
          RowBox[{"Max", "[", "V", "]"}], "+", "10"}]}], "}"}]}], ",", " ", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Position x [nm]\>\"", ",", 
         " ", "\"\<Potential V [eV]\>\""}], "}"}]}], ",", "  ", 
      RowBox[{"LabelStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"FontSize", "\[Rule]", "14"}], ",", 
         RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}], ",", " ", 
         "Black", ",", "Bold"}], "}"}]}]}], "]"}], ",", "\[IndentingNewLine]",
     "\[IndentingNewLine]", 
    RowBox[{"\"\<AxesSides\>\"", "\[Rule]", "\"\<TwoY\>\""}]}], "]"}],
  FontSize->14]], "Input",
