Cell[CellGroupData[{

Cell["Recalculate the Initial Wavefunction", "Subsubsection",
 CellChangeTimes->{{3.825085384609268*^9, 3.8250853960177813`*^9}, {
  3.8250917711582623`*^9, 3.825091774488023*^9}, {3.82509256741501*^9, 
  3.825092579209895*^9}, {3.825092668622217*^9, 3.8250926781397963`*^9}, {
  3.825093209489626*^9, 3.825093224891117*^9}, {3.952271178458324*^9, 
  3.952271180735201*^9}},ExpressionUUID->"82d67d47-cb25-45d3-9357-\
71e42c8f49e8"],

Cell[TextData[{
 StyleBox["Initialise the real (",
  FontSize->16],
 StyleBox["R0",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[") and imaginary (",
  FontSize->16],
 StyleBox["I0",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[") components of the wave function and compute their values at each \
grid point using a Gaussian envelope modulated by cosine (for the real part) \
and sine (for the imaginary part). Then, normalise the wave function \
according to the Born rule.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.825605567266796*^9, 3.825605572475891*^9}, {
   3.9522711462482033`*^9, 3.952271201474704*^9}, 
   3.9522713545091047`*^9},ExpressionUUID->"0ca2d947-1072-4018-92d3-\
ff75b5c5cdd7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"R0", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"Length", "[", "x", "]"}]}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{
   "Initialise", " ", "array", " ", "for", " ", "real", " ", "component"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"I0", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"0", ",", 
      RowBox[{"Length", "[", "x", "]"}]}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{
   "Initialise", " ", "array", " ", "for", " ", "imaginary", " ", 
    "component"}], "*)"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"nx", "=", "1"}], ",", 
    RowBox[{"nx", "<=", "numgrid"}], ",", 
    RowBox[{"nx", "++"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"R0", "[", 
       RowBox[{"[", "nx", "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "0.5"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", "nx", "]"}], "]"}], "-", 
              RowBox[{"x", "[", 
               RowBox[{"[", "wavecentreindex", "]"}], "]"}]}], ")"}], "/", 
            "s"}], ")"}], "^", "2"}]}], "]"}], "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"k", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "nx", "]"}], "]"}], "-", 
           RowBox[{"x", "[", 
            RowBox[{"[", "wavecentreindex", "]"}], "]"}]}], ")"}]}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"I0", "[", 
       RowBox[{"[", "nx", "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "0.5"}], "*", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", "nx", "]"}], "]"}], "-", 
              RowBox[{"x", "[", 
               RowBox[{"[", "wavecentreindex", "]"}], "]"}]}], ")"}], "/", 
            "s"}], ")"}], "^", "2"}]}], "]"}], "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"k", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "[", 
            RowBox[{"[", "nx", "]"}], "]"}], "-", 
           RowBox[{"x", "[", 
            RowBox[{"[", "wavecentreindex", "]"}], "]"}]}], ")"}]}], 
        "]"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Normalise", " ", "the", " ", "wavefunction"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modulus", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"R0", "^", "2"}], "+", 
           RowBox[{"I0", "^", "2"}]}], ")"}]}], "}"}], "]"}], ",", 
      RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"A", "=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"modulus", "[", "xval", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"xval", ",", "0", ",", "L"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"R0", "=", 
   RowBox[{"R0", "/", 
    RowBox[{"Sqrt", "[", "A", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"I0", "=", 
    RowBox[{"I0", "/", 
     RowBox[{"Sqrt", "[", "A", "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  
  RowBox[{"(*", 
   RowBox[{"Verify", " ", "normalisation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modulusNormalised", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"R0", "^", "2"}], "+", 
          RowBox[{"I0", "^", "2"}]}], ")"}]}], "}"}], "]"}], ",", 
     RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   RowBox[{"modulusNormalised", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.825605512806876*^9, 3.825605528882358*^9}, {
   3.951982713683969*^9, 3.95198271412854*^9}, {3.952271246549897*^9, 
   3.9522713010884333`*^9}, {3.9523395510376577`*^9, 3.952339552200679*^9}, {
   3.9523442868636847`*^9, 3.9523443143673153`*^9}, {3.952357060665969*^9, 
   3.9523570692352448`*^9}, 3.952357141561781*^9, 3.952357178721345*^9, 
   3.952434839256886*^9},
 FontSize->14,
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->"In[71]:=",ExpressionUUID->"cf8f585f-19da-4270-aa16-81888891615b"],

Cell[BoxData["1.`"], "Output",
