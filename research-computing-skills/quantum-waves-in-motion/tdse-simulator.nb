   3.952023237566142*^9}, {3.952023920680476*^9, 3.9520239780773087`*^9}, {
   3.95227970300459*^9, 3.95227970418159*^9}, {3.9522911041795063`*^9, 
   3.952291122492251*^9}, {3.952291928187058*^9, 3.952291929348518*^9}, {
   3.952341398025576*^9, 3.952341398715262*^9}, {3.9523420997797623`*^9, 
