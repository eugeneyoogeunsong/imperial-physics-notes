 RowBox[{
  RowBox[{
   RowBox[{"wellheight", "=", "80"}], ";"}], 
  "                                                ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Amplitude", "/", "height"}], " ", "of", " ", "the", " ", "well", 
    " ", "in", " ", "eV"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wellwidth", "=", "100"}], ";"}], 
  "                                                ", 
  RowBox[{"(*", 
   RowBox[{
   "Width", " ", "of", " ", "the", " ", "well", " ", "in", " ", "nm"}], 
   "*)"}]}], "\n", 
 RowBox[{
