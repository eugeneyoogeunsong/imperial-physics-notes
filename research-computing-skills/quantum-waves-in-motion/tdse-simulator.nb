Cell[TextData[{
 StyleBox["In this phase, the wavefunction is updated from one time step to \
the next using the finite-difference approximation.\nThe function for the ",
  FontSize->16],
 StyleBox["real",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" part, ",
  FontSize->16],
 StyleBox["\[Phi]R",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[", subtracts the",
  FontSize->16],
 StyleBox[" finite-difference",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" approximation of the imaginary part\[CloseCurlyQuote]s second \
derivative and adds the effect of the potential.\nSimilarly, the ",
  FontSize->16],
 StyleBox["imaginary",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" part function, ",
  FontSize->16],
 StyleBox["\[Phi]I",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[", adds the spatial finite-difference of the real part and \
subtracts the potential\[CloseCurlyQuote]s effect.\nThese two update \
equations work together to propagate the wavefunction while incorporating \
both kinetic and potential energy effects.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.825249977717369*^9, 3.82524998766357*^9}, {
   3.952022498487897*^9, 3.952022535059999*^9}, 3.952276471888254*^9, {
   3.9522908901626987`*^9, 3.9522908902219152`*^9}, {3.9522909234631567`*^9, 
   3.9522909245225277`*^9}},ExpressionUUID->"53d6818c-029d-447e-8031-\
f337ae0ec682"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Implement", " ", "the", " ", "Finite"}], "-", 
     RowBox[{"Domain", " ", "Time"}], "-", 
     RowBox[{
     "Difference", " ", "Method", " ", "for", " ", "Time", " ", 
      "Evolution"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
    "Update", " ", "the", " ", "real", " ", "component", " ", "of", " ", 
     "the", " ", "wavefunction", " ", "at", " ", "a", " ", "grid", " ", 
     "point"}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Phi]R", "[", 
       RowBox[{"\[Phi]R_", ",", "\[Phi]I_", ",", "nx_", ",", "V_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"\[Phi]R", "[", 
        RowBox[{"[", "nx", "]"}], "]"}], "-", 
       RowBox[{"c1", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Phi]I", "[", 
           RowBox[{"[", 
            RowBox[{"nx", "+", "1"}], "]"}], "]"}], "-", 
          RowBox[{"2", "*", 
           RowBox[{"\[Phi]I", "[", 
            RowBox[{"[", "nx", "]"}], "]"}]}], "+", 
          RowBox[{"\[Phi]I", "[", 
           RowBox[{"[", 
            RowBox[{"nx", "-", "1"}], "]"}], "]"}]}], ")"}]}], "+", 
       RowBox[{"c2", "*", 
        RowBox[{"V", "[", 
         RowBox[{"[", "nx", "]"}], "]"}], "*", 
        RowBox[{"\[Phi]I", "[", 
         RowBox[{"[", "nx", "]"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Update", " ", "the", " ", "imaginary", " ", "component", " ", "of", " ",
       "the", " ", "wavefunction", " ", "at", " ", "a", " ", "grid", " ", 
      "point"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Phi]I", "[", 
       RowBox[{"\[Phi]R_", ",", "\[Phi]I_", ",", "nx_", ",", "V_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"\[Phi]I", "[", 
        RowBox[{"[", "nx", "]"}], "]"}], "+", 
       RowBox[{"c1", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Phi]R", "[", 
           RowBox[{"[", 
            RowBox[{"nx", "+", "1"}], "]"}], "]"}], "-", 
          RowBox[{"2", "*", 
           RowBox[{"\[Phi]R", "[", 
            RowBox[{"[", "nx", "]"}], "]"}]}], "+", 
          RowBox[{"\[Phi]R", "[", 
           RowBox[{"[", 
            RowBox[{"nx", "-", "1"}], "]"}], "]"}]}], ")"}]}], "-", 
       RowBox[{"c2", "*", 
        RowBox[{"V", "[", 
         RowBox[{"[", "nx", "]"}], "]"}], "*", 
        RowBox[{"\[Phi]R", "[", 
         RowBox[{"[", "nx", "]"}], "]"}]}]}]}], ";"}]}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.8251614690499287`*^9, 3.8251615000714417`*^9}, {
   3.8251615941803703`*^9, 3.825161657891897*^9}, {3.825161725258906*^9, 
   3.82516181419903*^9}, {3.825162052727042*^9, 3.825162060307374*^9}, {
   3.825162182657399*^9, 3.8251622468591146`*^9}, {3.825162573781248*^9, 
   3.825162580128783*^9}, {3.82516286720011*^9, 3.82516286951692*^9}, {
   3.825162905199772*^9, 3.825162907360538*^9}, {3.825166806559596*^9, 
   3.825166808664352*^9}, {3.825249421929928*^9, 3.825249460289584*^9}, {
   3.825249552437258*^9, 3.825249553083482*^9}, {3.825249592435707*^9, 
   3.8252496412853317`*^9}, {3.825249715696723*^9, 3.8252499414937773`*^9}, {
   3.82541726930492*^9, 3.825417275219632*^9}, {3.8256594522389402`*^9, 
   3.8256594786290703`*^9}, 3.952022701325856*^9, {3.952290999713423*^9, 
   3.952291003575158*^9}},
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->"In[58]:=",ExpressionUUID->"30c40f90-9667-4887-933d-502994e5f664"],

Cell[TextData[{
 StyleBox["Next, we execute a loop that propagates the wavefunction in time. \
At every frame interval, the current real and imaginary components are \
recorded, allowing us to later construct an animation. \n\nThis procedure is \
encapsulated in the function ",
  FontSize->16],
 StyleBox["timeEvolutionEuler",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". This section is central to the numerical solution of the TDSE.  ",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.825261257399419*^9, 3.825261340916464*^9}, {
   3.825587541045038*^9, 3.825587570903995*^9}, {3.951982377580991*^9, 
   3.951982382469606*^9}, {3.951982524050387*^9, 3.9519825260804653`*^9}, {
   3.9519946571182117`*^9, 3.9519946634464273`*^9}, {3.951994730803617*^9, 
   3.951994736097563*^9}, 3.952013864951284*^9, {3.952022711470233*^9, 
   3.95202271593268*^9}, {3.952022856936223*^9, 3.952022873686131*^9}, {
   3.952196125980665*^9, 3.952196128575018*^9}, 3.9522755118431253`*^9, 
   3.952593841045014*^9, 
   3.952593919684554*^9},ExpressionUUID->"8cf008b8-4248-4687-84c1-\
7fdba6685b80"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{"timeEvolutionEuler", "[", 
     RowBox[{"R0_", ",", "I0_", ",", "V_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"times", ",", "RtFrames", ",", "ItFrames", ",", "PtFrames"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Initialise", " ", "the", " ", "wavefunction", " ", "components", " ", 
        "to", " ", "the", " ", "initial", " ", "state"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Rt", "=", "R0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"It", "=", "I0"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Prepare", " ", "empty", " ", "lists", " ", "to", " ", "record", " ", 
         "the", " ", "evolution", " ", "at", " ", "selected", " ", "time", " ",
          "frames"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"RtFrames", "=", 
        RowBox[{"{", "}"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"Real", " ", "part", " ", "snapshots"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"ItFrames", "=", 
        RowBox[{"{", "}"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"Imaginary", " ", "part", " ", "snapshots"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"PtFrames", "=", 
        RowBox[{"{", "}"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"Probability", " ", "density", " ", "snapshots"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"times", "=", 
        RowBox[{"{", "}"}]}], ";", "       ", 
       RowBox[{"(*", 
        RowBox[{
        "Corresponding", " ", "time", " ", "stamps", " ", "for", " ", "each", 
         " ", "saved", " ", "frame"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Propagate", " ", "the", " ", "wavefunction", " ", "over", " ", "the",
          " ", "total", " ", "simulation", " ", "time"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"nt", "=", "1"}], ",", 
         RowBox[{"nt", "<=", "ntimestep"}], ",", 
         RowBox[{"nt", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Update", " ", "the", " ", "real", " ", "component", " ", "at", " ",
            "interior", " ", "grid", " ", "points"}], "*)"}], "  ", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"nx", "=", "2"}], ",", 
            RowBox[{"nx", "<=", 
             RowBox[{"(", 
              RowBox[{"numgrid", "-", "1"}], ")"}]}], ",", 
            RowBox[{"nx", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"Rt", "[", 
               RowBox[{"[", "nx", "]"}], "]"}], "=", 
              RowBox[{"\[Phi]R", "[", 
               RowBox[{"Rt", ",", "It", ",", "nx", ",", "V"}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Update", " ", "the", " ", "imaginary", " ", "component", " ", 
            "at", " ", "interior", " ", "grid", " ", "points"}], "*)"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", "   ", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"nx", "=", "2"}], ",", 
            RowBox[{"nx", "<=", 
             RowBox[{"(", 
              RowBox[{"numgrid", "-", "1"}], ")"}]}], ",", 
            RowBox[{"nx", "++"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"It", "[", 
               RowBox[{"[", "nx", "]"}], "]"}], "=", 
              RowBox[{"\[Phi]I", "[", 
               RowBox[{"Rt", ",", "It", ",", "nx", ",", "V"}], "]"}]}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Save", " ", "the", " ", "state", " ", "at", " ", "regular", " ", 
            "frame", " ", "intervals", " ", "for", " ", "later", " ", 
            "visualisation"}], "*)"}], "\[IndentingNewLine]", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"nt", ",", "framestep"}], "]"}], "==", "0"}], ",", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", "      ", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"RtFrames", ",", "Rt"}], "]"}], ";", "              ", 
             "  ", 
             RowBox[{"(*", 
              RowBox[{
              "Save", " ", "snapshot", " ", "of", " ", "real", " ", "part"}], 
              "*)"}], "\[IndentingNewLine]", "      ", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"ItFrames", ",", "It"}], "]"}], ";", "              ", 
             "  ", 
             RowBox[{"(*", 
              RowBox[{
              "Save", " ", "snapshot", " ", "of", " ", "imaginary", " ", 
               "part"}], "*)"}], "\[IndentingNewLine]", "  ", "  ", "  ", 
             "\[IndentingNewLine]", "  ", "  ", "  ", 
             RowBox[{"timeElapsed", "=", 
              RowBox[{"nt", "*", "dt"}]}], ";", "\[IndentingNewLine]", 
             "      ", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"times", ",", "timeElapsed"}], "]"}], ";", "  ", 
             RowBox[{"(*", 
              RowBox[{"Record", " ", "the", " ", "simulation", " ", "time"}], 
              "*)"}], "\[IndentingNewLine]", "      ", 
             RowBox[{"Pt", "=", 
              RowBox[{
               RowBox[{"Rt", "^", "2"}], "+", 
               RowBox[{"It", "^", "2"}]}]}], ";", 
             "                             ", "   ", 
             RowBox[{"(*", 
              RowBox[{
              "Compute", " ", "the", " ", "probability", " ", "density"}], 
              "*)"}], "\[IndentingNewLine]", "      ", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"PtFrames", ",", "Pt"}], "]"}], ";"}]}], 
           "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Package", " ", "the", " ", "saved", " ", "data", " ", "into", " ", 
         "a", " ", "result", " ", "vector", " ", "for", " ", "later", " ", 
         "use", " ", "in", " ", "plotting"}], "*)"}], "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"result", "=", 
        RowBox[{"{", 
         RowBox[{"times", ",", "RtFrames", ",", "ItFrames", ",", "PtFrames"}],
          "}"}]}], ";", "\[IndentingNewLine]", "    ", "result"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.952022937276128*^9, 3.952023009162609*^9}, {
   3.952196130674458*^9, 3.952196131622917*^9}, 3.952279764879366*^9, {
   3.952290952713305*^9, 3.95229098648001*^9}, {3.952291072965416*^9, 
   3.952291080617321*^9}, {3.952339537693852*^9, 3.9523395414163218`*^9}, {
   3.952339714892082*^9, 3.9523397195359364`*^9}, {3.9523454455509033`*^9, 
   3.952345481478709*^9}, {3.952345512754447*^9, 3.9523455128767*^9}, 
   3.952345794745953*^9, {3.9523463920738792`*^9, 3.952346424467114*^9}},
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->"In[60]:=",ExpressionUUID->"30796df8-e8cc-4d04-a8a6-2e2794efc98a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["As a Side Note: Using a Runge\[Dash]Kutta Scheme",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.8251485371976767`*^9, 3.82514854919247*^9}, {
  3.952011747312974*^9, 3.952011747971097*^9}, {3.952011795182362*^9, 
  3.952011796955278*^9}, {3.9522793139754353`*^9, 
  3.952279325505559*^9}},ExpressionUUID->"9c463438-3902-4c96-b3b1-\
4f79a2b43f73"],

Cell[TextData[{
 "An alternative to the Euler method for propagating the wavefunction is the ",
 StyleBox["Runge-Kutta (RK4)",
  FontWeight->"Bold"],
 StyleBox[" method",
  FontWeight->"Bold"],
 ". The RK4 method is a fourth-order integration scheme that computes four \
intermediate slopes ",
 StyleBox["(k\:2081, k\:2082, k\:2083, k\:2084)",
  FontWeight->"Bold"],
 " at each time step. Because of its higher order accuracy (global error on \
the order of ",
 StyleBox["O(\[CapitalDelta]t\:2074)",
  FontWeight->"Bold"],
 "), the RK4 method can significantly improve both stability and precision \
compared to simpler methods like Euler\[CloseCurlyQuote]s. In our \
implementation, each intermediate slope is computed using the updated \
derivative function (which accounts for time-dependent potentials), and then \
these slopes are combined to update both the real (",
 StyleBox["Rt",
  FontWeight->"Bold"],
 ") and imaginary (",
 StyleBox["It",
  FontWeight->"Bold"],
 ") components of the wavefunction simultaneously. Furthermore, to mimic an \
unbounded domain, absorbing boundary conditions are applied at each step to \
damp non-physical reflections at the edges. Although this approach provides \
greater accuracy, we have opted to ",
 StyleBox["use the Euler method in our final implementation for simplicity.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{
  3.952279362547699*^9, {3.95227943342418*^9, 3.952279453166169*^9}, {
   3.952513760478689*^9, 3.9525137614167957`*^9}, {3.952513900145063*^9, 
   3.9525139011501303`*^9}, {3.952593872877858*^9, 3.952593882479577*^9}, {
   3.9525939821423273`*^9, 
   3.952593999269417*^9}},ExpressionUUID->"b6ac6c29-159d-4e1d-9849-\
c461eb76a1db"],

Cell[TextData[{
 StyleBox["Optional: ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["If you want to use the ",
  FontSize->16],
 StyleBox["RK4 method, ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["you can extend the potential library to include time-dependent \
potentials\[LongDash]a switching potential and an oscillatory potential\
\[LongDash]by defining functions ",
  FontSize->16],
 StyleBox["timeDependentPotential",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" and ",
  FontSize->16],
 StyleBox["oscillatoryPotential",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[". These time-dependent functions use parameters ",
  FontSize->16],
 StyleBox["(t0, V1, V2, V0, \[Omega])",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" to allow for dynamic changes in the potential over time. The use \
of the ",
  FontSize->16],
 StyleBox["UnitBox",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" function limits these potentials to a specific region of the \
domain, which is critical for modeling localized interactions. A modular \
function (",
  FontSize->16],
 StyleBox["choosePotential",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[") is then provided to select among these potentials, ensuring \
flexibility in the simulation setup.\nHere, the ",
  FontSize->16],
 StyleBox["ComputeDerivatives",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" function is updated to accept a time parameter ",
  FontSize->16],
 StyleBox["t",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" so that the potential can be evaluated dynamically, which is \
essential for ",
  FontSize->16],
 StyleBox["time-dependent",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" simulations. The function computes the second spatial derivatives \
using a central",
  FontSize->16],
 StyleBox[" finite difference scheme",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" (employing ",
  FontSize->16],
 StyleBox["RotateLeft",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" and ",
  FontSize->16],
 StyleBox["RotateRight",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox["), ensuring that the derivative arrays (",
  FontSize->16],
 StyleBox["dR",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" and ",
  FontSize->16],
 StyleBox["dI",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[") have the same dimensions as the wavefunction arrays.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.952338991025897*^9, 3.952339007357658*^9}, {
  3.9525137722196417`*^9, 3.952513800582906*^9}, {3.952593892350479*^9, 
  3.952593893412158*^9}, {3.952593935708727*^9, 
  3.952593935889833*^9}},ExpressionUUID->"03ce3474-275a-4080-a853-\
ed689473173e"],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Extended"}]}], " ", "Potential", " ", 
     RowBox[{"Library", ":", " ", 
      RowBox[{"Time", "-", 
       RowBox[{"Dependent", " ", 
        RowBox[{"Potentials", "--"}]}], "-"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "a", " ", "switching", " ", "potential", " ", "that", " ", 
     "varies", " ", "with", " ", "time"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"timeDependentPotential", "[", 
       RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"t", "<", "t0"}], ",", "V1", ",", "V2"}], "]"}], "*", 
       RowBox[{"UnitBox", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"L", "/", "2"}]}], ")"}], "/", "wellwidth"}], "]"}]}]}], 
     ";"}], "\[IndentingNewLine]", "\n", 
    RowBox[{"(*", 
     RowBox[{
     "Define", " ", "an", " ", "oscillatory", " ", "potential", " ", "using", 
      " ", "cosine", " ", "modulation"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"oscillatoryPotential", "[", 
       RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
      RowBox[{"V0", "*", 
       RowBox[{"Cos", "[", 
        RowBox[{"\[Omega]", "*", "t"}], "]"}], "*", 
       RowBox[{"UnitBox", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"L", "/", "2"}]}], ")"}], "/", "wellwidth"}], "]"}]}]}], 
     ";"}], "\n", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Set", " ", "the", " ", "parameters", " ", "for", " ", "time"}],
       "-", 
      RowBox[{"dependent", " ", "potentials"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t0", "=", "50"}], ";"}], "        ", 
    RowBox[{"(*", 
     RowBox[{
     "Time", " ", "threshold", " ", "for", " ", "switching", " ", 
      "behavior"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"V1", "=", 
      RowBox[{"-", "80"}]}], ";"}], "     ", 
    RowBox[{"(*", 
     RowBox[{
     "Potential", " ", "value", " ", "before", " ", "the", " ", "switch"}], 
     "*)"}], "\n", 
    RowBox[{
     RowBox[{"V2", "=", "80"}], ";"}], "       ", 
    RowBox[{"(*", 
     RowBox[{
     "Potential", " ", "value", " ", "after", " ", "the", " ", "switch"}], 
     "*)"}], "\n", 
    RowBox[{
     RowBox[{"V0", "=", "50"}], ";"}], "       ", 
    RowBox[{"(*", 
     RowBox[{
     "Amplitude", " ", "for", " ", "the", " ", "oscillatory", " ", 
      "potential"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"\[Omega]", "=", "0.1"}], ";"}], "       ", 
    RowBox[{"(*", 
     RowBox[{"Angular", " ", "frequency", " ", "of", " ", "oscillation"}], 
     "*)"}], "\[IndentingNewLine]", "\n", 
    RowBox[{
     RowBox[{"dtRescaled", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"c1", "*", "2", "*", "me", "*", 
         RowBox[{"dx", "^", "2"}], "*", "10"}], ")"}], "/", "hbar"}]}], ";"}],
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Example", ":", " ", 
       RowBox[{
       "Evaluate", " ", "the", " ", "switching", " ", "potential", " ", "at", 
        " ", "t"}]}], "=", 
      RowBox[{"0", " ", "for", " ", "all", " ", "grid", " ", "points"}]}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"V_td", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"timeDependentPotential", "[", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "x", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
    
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Time-dependent potential at t = 0: \>\"", ",", "V_td"}], 
      "]"}], ";"}], "\n", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "Updating"}]}], " ", "the", " ", "Derivative", " ", 
       "Computation", " ", "to", " ", "Include", " ", 
       RowBox[{"Time", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "The", " ", "ComputeDerivatives", " ", "function", " ", "now", " ", 
       "accepts", " ", "a", " ", "time", " ", "argument", " ", "t"}], ",", 
      " ", 
      RowBox[{
      "enabling", " ", "dynamic", " ", "evaluation", " ", "of", " ", "the", " ", 
       RowBox[{"potential", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"ComputeDerivatives", "[", 
       RowBox[{"Rt_", ",", "It_", ",", "t_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"dR", ",", "dI", ",", "currentPotential"}], "}"}], ",", 
        RowBox[{
         RowBox[{"currentPotential", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"potential", "===", "\"\<time-dependent\>\""}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"timeDependentPotential", "[", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", "t"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "[", "x", "]"}]}], "}"}]}], "]"}], ",", 
            "V"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Calculate", " ", "the", " ", "second", " ", "spatial", " ", 
           "derivative", " ", "using", " ", "central", " ", "differences"}], 
          "*)"}], 
         RowBox[{"dR", "=", 
          RowBox[{
           RowBox[{"c1", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"RotateLeft", "[", 
               RowBox[{"It", ",", "1"}], "]"}], "-", 
              RowBox[{"2", " ", "It"}], "+", 
              RowBox[{"RotateRight", "[", 
               RowBox[{"It", ",", "1"}], "]"}]}], ")"}]}], "-", 
           RowBox[{"c2", "*", "currentPotential", "*", "It"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"dI", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "c1"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"RotateLeft", "[", 
               RowBox[{"Rt", ",", "1"}], "]"}], "-", 
              RowBox[{"2", " ", "Rt"}], "+", 
              RowBox[{"RotateRight", "[", 
               RowBox[{"Rt", ",", "1"}], "]"}]}], ")"}]}], "+", 
           RowBox[{"c2", "*", "currentPotential", "*", "Rt"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"dR", ",", "dI"}], "}"}]}]}], "]"}]}], ";"}]}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{
  3.95229246402085*^9, {3.952515000225525*^9, 3.952515042863264*^9}, {
   3.952515185237747*^9, 3.9525152051239223`*^9}},
 Background->RGBColor[1, 0.9, 1],
 CellLabel->
  "In[186]:=",ExpressionUUID->"a4a44782-9d82-47cd-9ced-c4086356893b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Time-dependent potential at t = 0: \"\>", "\[InvisibleSpace]", 
   "V_td"}],
  SequenceForm["Time-dependent potential at t = 0: ", 
   Pattern[$CellContext`V, 
    Blank[$CellContext`td]]],
  Editable->False]], "Print",
 CellChangeTimes->{3.952338698891747*^9, 3.952339965336207*^9, 
  3.9523409957838163`*^9, 3.952342764174099*^9, 3.952344894236229*^9, 
  3.952345661611936*^9, 3.9523461702562513`*^9, 3.9524355262679977`*^9, 
  3.952510731291586*^9, 3.952514805950837*^9, 3.952515087168454*^9, 
  3.952515235476452*^9, 3.9525155861539717`*^9, 3.952515756995043*^9},
 CellLabel->
  "During evaluation of \
In[186]:=",ExpressionUUID->"0a45d2aa-ea30-46cd-91fc-20a4b1696295"]
}, Open  ]],

Cell[TextData[{
 "Below is an example of how the ",
 StyleBox["RK4 method",
  FontWeight->"Bold"],
 " can be implemented:"
}], "Text",
 CellChangeTimes->{{3.9525139068852997`*^9, 
  3.952513914883493*^9}},ExpressionUUID->"0a80f6ee-4015-44d0-a065-\
1ea44ed9c417"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "RK4Step"}]}], " ", "Function", " ", "with", " ", "Time", 
      " ", 
      RowBox[{"Passing", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RK4Step", "[", 
      RowBox[{"Rt_", ",", "It_", ",", "t_", ",", " ", "dtRescaled_"}], "]"}], 
     ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "k1R", ",", "k1I", ",", "k2R", ",", "k2I", ",", "k3R", ",", "k3I", ",",
          "k4R", ",", "k4I"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k1R", ",", "k1I"}], "}"}], "=", 
         RowBox[{"ComputeDerivatives", "[", 
          RowBox[{"Rt", ",", "It", ",", "t"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k2R", ",", "k2I"}], "}"}], "=", 
         RowBox[{"ComputeDerivatives", "[", 
          RowBox[{
           RowBox[{"Rt", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"dtRescaled", " ", "/", "2"}], ")"}], "*", "k1R"}]}], ",", 
           RowBox[{"It", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"dtRescaled", " ", "/", "2"}], ")"}], "*", "k1I"}]}], ",", 
           RowBox[{"t", "+", 
            RowBox[{"dtRescaled", " ", "/", "2"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k3R", ",", "k3I"}], "}"}], "=", 
         RowBox[{"ComputeDerivatives", "[", 
          RowBox[{
           RowBox[{"Rt", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"dtRescaled", " ", "/", "2"}], ")"}], "*", "k2R"}]}], ",", 
           RowBox[{"It", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"dtRescaled", " ", "/", "2"}], ")"}], "*", "k2I"}]}], ",", 
           RowBox[{"t", "+", 
            RowBox[{"dtRescaled", " ", "/", "2"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k4R", ",", "k4I"}], "}"}], "=", 
         RowBox[{"ComputeDerivatives", "[", 
          RowBox[{
           RowBox[{"Rt", "+", 
            RowBox[{"dtRescaled", " ", "*", "k3R"}]}], ",", 
           RowBox[{"It", "+", 
            RowBox[{"dtRescaled", " ", "*", "k3I"}]}], ",", 
           RowBox[{"t", "+", "dtRescaled"}]}], " ", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<k1 = \>\"", ",", 
          RowBox[{"{", 
           RowBox[{"k1R", ",", "k1I"}], "}"}]}], "]"}], ";", "\n", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<k2 = \>\"", ",", 
          RowBox[{"{", 
           RowBox[{"k2R", ",", "k2I"}], "}"}]}], "]"}], ";", "\n", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<k3 = \>\"", ",", 
          RowBox[{"{", 
           RowBox[{"k3R", ",", "k3I"}], "}"}]}], "]"}], ";", "\n", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<k4 = \>\"", ",", 
          RowBox[{"{", 
           RowBox[{"k4R", ",", "k4I"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Rt", "+", 
           RowBox[{
            RowBox[{"dtRescaled", " ", "/", "6"}], "*", 
            RowBox[{"(", 
             RowBox[{"k1R", "+", 
              RowBox[{"2", "*", "k2R"}], "+", 
              RowBox[{"2", "*", "k3R"}], "+", "k4R"}], ")"}]}]}], ",", 
          RowBox[{"It", "+", 
           RowBox[{
            RowBox[{"dtRescaled", " ", "/", "6"}], "*", 
            RowBox[{"(", 
             RowBox[{"k1I", "+", 
              RowBox[{"2", "*", "k2I"}], "+", 
              RowBox[{"2", "*", "k3I"}], "+", "k4I"}], ")"}]}]}]}], "}"}]}]}],
       "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]"}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{
  3.9522910193056717`*^9, 3.952291052766872*^9, 3.9522919225521803`*^9, {
   3.952515055405878*^9, 3.95251506754419*^9}, {3.952515467466345*^9, 
   3.952515471428639*^9}, {3.9525155782135677`*^9, 3.952515664499193*^9}},
 Background->RGBColor[1, 0.9, 1],
 CellLabel->
  "In[197]:=",ExpressionUUID->"28595902-4823-41e6-bd84-36a5e23ef99f"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"AbsorbingBoundary", "[", "psi_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N", "=", 
        RowBox[{"Length", "[", "psi", "]"}]}], ",", "d", ",", "absorber"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Define", " ", "the", " ", "thickness", " ", "of", " ", "the", " ", 
       "absorbing", " ", "layer", " ", "as", " ", "10", "%", " ", "of", " ", 
       "the", " ", "grid", " ", "size"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"d", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{"0.1", "*", "N"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Create", " ", "a", " ", "damping", " ", 
         RowBox[{"profile", ":", 
          RowBox[{
           RowBox[{"-", "For"}], " ", "indices", " ", "near", " ", "the", " ",
            "left", " ", "boundary", " ", 
           RowBox[{"(", 
            RowBox[{"i", "<=", "d"}], ")"}]}]}]}], ",", 
        RowBox[{
         RowBox[{
         "the", " ", "damping", " ", "factor", " ", "decays", " ", "from", " ",
           "1", " ", "to", " ", "0."}], "-", 
         RowBox[{
         "For", " ", "indices", " ", "near", " ", "the", " ", "right", " ", 
          "boundary", " ", 
          RowBox[{"(", 
           RowBox[{"i", ">", 
            RowBox[{"N", "-", "d"}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{
         "the", " ", "damping", " ", "factor", " ", "decays", " ", "from", " ",
           "1", " ", "to", " ", "0."}], "-", 
         RowBox[{"In", " ", "the", " ", "interior"}]}], ",", " ", 
        RowBox[{
        "the", " ", "damping", " ", "factor", " ", "is", " ", "1."}]}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"absorber", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"i", "<=", "d"}], ",", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"d", "-", "i"}], ")"}], "/", "d"}], ")"}], "^", 
              "2"}]}], "]"}], ",", 
           RowBox[{"i", ">", 
            RowBox[{"N", "-", "d"}]}], ",", 
           RowBox[{"Exp", "[", 
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"i", "-", 
                  RowBox[{"(", 
                   RowBox[{"N", "-", "d"}], ")"}]}], ")"}], "/", "d"}], ")"}],
               "^", "2"}]}], "]"}], ",", "True", ",", "1"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "N"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Multiply", " ", "the", " ", "input", " ", "wavefunction", " ", "by", 
         " ", "the", " ", "damping", " ", "profile", " ", "element"}], "-", 
        "wise"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"psi", "*", "absorber"}]}]}], "]"}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.952339823418178*^9, 3.952339840931666*^9}, 
   3.952514891783486*^9},
 Background->RGBColor[1, 0.9, 1],
 CellLabel->
