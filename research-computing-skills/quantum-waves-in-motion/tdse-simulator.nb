Cell[TextData[{
 StyleBox["Additionally, the following plot of the initial probability \
density\[LongDash]calculated as the sum of the squares of the wavefunction \
components\[LongDash]is provided. This confirms that ",
  FontSize->16],
 StyleBox["the wavefunction is properly normalised",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" according to the ",
  FontSize->16],
 StyleBox["Born rule",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[".",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.952022170238308*^9, 3.952022174367029*^9}, {
  3.952275340153635*^9, 
  3.952275340215403*^9}},ExpressionUUID->"27113d54-1037-4425-b65d-\
9a6dc092903e"],

