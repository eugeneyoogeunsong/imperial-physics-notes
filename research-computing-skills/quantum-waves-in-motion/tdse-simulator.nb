Cell[TextData[StyleBox["Usage Instructions:", "Section",
 FontSize->24]], "Title",
 CellChangeTimes->{{3.825071740231655*^9, 3.8250717467536783`*^9}, {
  3.825658923465767*^9, 3.825658925530876*^9}, {3.951991559439692*^9, 
  3.9519915609531527`*^9}},ExpressionUUID->"3d3b78df-c82b-4496-ab74-\
4d7fb00d78bf"],

Cell[TextData[{
 StyleBox["Overview:",
  FontWeight->"Bold"],
 " The notebook begins by establishing a physical context and setting up the \
potential landscape. It then defines and displays the initial wavefunction, \
followed by several example simulations. In the final section, users are \
encouraged to modify parameters and explore the simulation further."
}], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
