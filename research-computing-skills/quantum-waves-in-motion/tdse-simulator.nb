Cell[CellGroupData[{

Cell[TextData[StyleBox["Project Objective: ", "Section",
 FontSize->24]], "Title",
 CellChangeTimes->{{3.825071482488907*^9, 3.825071499321231*^9}, {
  3.825071550666162*^9, 3.82507155268943*^9}, {3.9519905583154287`*^9, 
  3.95199058066892*^9}},ExpressionUUID->"c62dc5c0-9a7f-4d58-bc71-\
c41fc6dd9f11"],

Cell[TextData[StyleBox["The primary objective of this project is to \
numerically solve the time-dependent Schr\[ODoubleDot]dinger equation (TDSE) \
using a finite-domain time-difference (FDTD) method. This simulation is \
designed to model electron dynamics and provide intuitive insight into \
quantum behavior.",
 FontSize->16]], "Text",
 CellChangeTimes->{
  3.9519905846819067`*^9, 3.95199132940949*^9, {3.951992288465045*^9, 
   3.951992290315618*^9}, 3.952290155538747*^9},
 FontSize->16,ExpressionUUID->"bebfd33f-fcb6-4c37-bb0f-04f1883609e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Theoretical Background:", "Section",
 FontSize->24]], "Title",
 CellChangeTimes->{{3.825071659544959*^9, 3.825071669510104*^9}, {
  3.951990607803392*^9, 3.9519906094735518`*^9}, {3.951991346291383*^9, 
  3.951991349966744*^9}},ExpressionUUID->"21197d1c-e7bd-431e-9f08-\
71735196427f"],

Cell[TextData[{
 StyleBox["The TDSE (",
  FontSize->16],
 StyleBox[" i\[HBar]\:202f \[PartialD]\[CapitalPsi](x,t)/\[PartialD]t  =  \
H(x) \[CapitalPsi](x,t) ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[") governs the evolution of quantum systems. Here, the Hamiltonian ",
  FontSize->16],
 StyleBox["H(x)",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" comprises two main components: kinetic (",
  FontSize->16],
 StyleBox[" \[Minus]\[HBar]\.b2/(2m) \:202f\[PartialD]\.b2/\[PartialD]x\.b2 ",
  
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[") and potential energy, ",
  FontSize->16],
 StyleBox["V(x),",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" components.",
  FontSize->16]
}], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.95199137381304*^9, 3.951991382952771*^9}, {
   3.952274087912405*^9, 3.952274112497986*^9}, {3.952290173855811*^9, 
   3.952290260411202*^9}},
 FontSize->16,ExpressionUUID->"19942c16-f645-4f10-8990-cb6919fbb979"],

Cell[TextData[{
 "Finite-difference approximations discretize both time (",
 StyleBox["\:2206t",
  FontWeight->"Bold"],
 ") and space (",
 StyleBox["\:2206x",
  FontWeight->"Bold"],
 ") for numerical integration.\n",
 StyleBox["\n",
  FontSize->16],
 "For further details, readers may refer to ",
 StyleBox[" \[OpenCurlyDoubleQuote]Solve_TDSE_Y.Song.pdf\
\[CloseCurlyDoubleQuote].",
  FontWeight->"Bold"]
}], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.95199137381304*^9, 3.951991396168269*^9}, {
   3.952290282132218*^9, 3.9522902830661077`*^9}},
 FontSize->16,ExpressionUUID->"ca261870-10e1-4b62-90f3-30eef5314663"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Methodology:", "Section",
 FontSize->24]], "Title",
 CellChangeTimes->{{3.825071659544959*^9, 3.825071669510104*^9}, {
  3.951990607803392*^9, 
  3.9519906094735518`*^9}},ExpressionUUID->"1654380d-9260-4a07-9c4f-\
ed23c980ea51"],

Cell[TextData[{
 StyleBox["We begin by initialising a",
  FontSize->16],
 StyleBox[" normalised Gaussian wave packet",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\[LongDash]modulated by sine and cosine functions\[LongDash]to \
represent the electron\[CloseCurlyQuote]s state on a discretised spatial grid \
(typically 1000 points over 500\:202fnm). ",
  FontSize->16]
}], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, 3.951991403363646*^9, {3.952273890749693*^9, 
   3.952273898141798*^9}, {3.952275397815024*^9, 3.952275400281142*^9}, {
   3.952290321645226*^9, 3.952290331434639*^9}, {3.9525938256689262`*^9, 
   3.952593825861393*^9}},
 FontSize->16,ExpressionUUID->"68de162f-da7c-405c-9c9d-e8ff547bee2d"],

Cell[TextData[{
 StyleBox["The wavefunction is separated into its ",
  FontSize->16],
 StyleBox["real ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["and ",
  FontSize->16],
 StyleBox["imaginary",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" components, which are then updated over time using \
finite-difference schemes with appropriately chosen constants",
  FontSize->16],
 "."
}], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990647426201*^9}, {3.9519906780641747`*^9, 3.951990709829843*^9}, 
   3.951990783934013*^9, 3.951991409112269*^9, {3.95229031135124*^9, 
   3.952290319814341*^9}, {3.952290356395261*^9, 3.9522903674377728`*^9}, {
   3.9525107037711363`*^9, 3.952510704467435*^9}},
 FontSize->16,ExpressionUUID->"48c8435b-6052-4c3e-a1ca-127bf48f5db4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Simulation Setup & Exploration:", "Section",
 FontSize->24]], "Title",
 CellChangeTimes->{{3.82507170951576*^9, 3.8250717185140467`*^9}, {
  3.951990724282638*^9, 3.951990735431038*^9}, {3.9519914143145103`*^9, 
  3.9519914179193077`*^9}},ExpressionUUID->"b9162043-b20f-4a97-a2af-\
6bb5efd44d97"],

Cell[TextData[{
 StyleBox["This Mathematica notebook provides detailed, colour-coded \
instructions that guide users through both essential steps and customisable \
parameters. The simulation framework allows exploration of various potential \
energy landscapes, including:\n\n\t\[Bullet]\tFree Particle: ",
  FontSize->16],
 StyleBox["V(x) = 0",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["\n\t\[Bullet]\tFinite Square Well\n\t\[Bullet]\tQuadratic \
(Harmonic) Well\n\t\[Bullet]\tStep Potential\n\t\nThese options enable users \
to examine how different potentials influence the evolution of the quantum \
wave packet.",
  FontSize->16]
}], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.951990751286961*^9, 3.951990755392063*^9}, 
   3.9519914256445932`*^9, {3.952290404657095*^9, 3.952290426922236*^9}, 
   3.9522906221566772`*^9},
 FontSize->16,ExpressionUUID->"d77d77ec-d511-4c2a-b056-071d256b86c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Visualisation & Analysis:", "Section",
 FontSize->24]], "Title",
 CellChangeTimes->{{3.825071740231655*^9, 3.8250717467536783`*^9}, {
  3.951990801655505*^9, 3.951990804668336*^9}, {3.951991447955024*^9, 
  3.951991454765758*^9}},ExpressionUUID->"75b7b318-ba64-4e7a-965b-\
0da148d16207"],

Cell[TextData[{
 StyleBox["The simulation computes the probability density, ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["|",
     FontSize->16], 
    StyleBox[" ",
     FontSize->16,
     FontWeight->"Bold"], 
    StyleBox[
     RowBox[{"\[CapitalPsi]", "(", 
      RowBox[{"x", ",", "t"}], ")"}],
     FontSize->16,
     FontWeight->"Bold"], 
    SuperscriptBox[
     StyleBox["|",
      FontSize->16], "2"]}], TraditionalForm]],
  FormatType->TraditionalForm,
  FontWeight->"Bold",ExpressionUUID->"f6942806-be64-4b57-891b-51793e0d4bf0"],
 StyleBox[",",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" and generates dynamic visualisations (as ",
  FontSize->16],
 StyleBox["videos or GIFs",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[") that reveal key quantum phenomena such as dispersion, \
reflection, interference, and tunneling. ",
  FontSize->16]
}], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.951990751286961*^9, 3.951990786758065*^9}, 
   3.951990843862741*^9, {3.951991460587331*^9, 3.9519914647097*^9}, {
   3.952290453492189*^9, 3.952290473115283*^9}, {3.952290573753994*^9, 
   3.952290605389161*^9}},
 FontSize->16,ExpressionUUID->"2c8ecb74-08e0-4f92-86f9-aaa13a55e9a3"],

Cell[TextData[StyleBox["This visualisation not only reinforces fundamental \
quantum principles but also highlights potential future \
extensions\[LongDash]such as the incorporation of time-dependent potentials\
\[LongDash]to further enhance our understanding of quantum dynamics.",
 FontSize->16]], "Text",
 CellDingbat->"\[FilledSmallCircle]",
 CellChangeTimes->{
  3.8250716838935738`*^9, {3.8250816215083427`*^9, 3.82508171008912*^9}, {
   3.8256588109999638`*^9, 3.825658811863256*^9}, {3.951990632666698*^9, 
   3.951990676279611*^9}, {3.951990751286961*^9, 3.951990786758065*^9}, 
   3.951990843862741*^9, {3.951991460587331*^9, 3.9519914725638847`*^9}, {
   3.952290469023602*^9, 3.9522904709075737`*^9}},
 FontSize->16,ExpressionUUID->"484713ca-3b2e-454f-af52-42b778d9c89b"]
}, Open  ]],

