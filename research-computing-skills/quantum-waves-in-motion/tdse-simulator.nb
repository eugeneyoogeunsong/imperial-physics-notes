Cell[CellGroupData[{

Cell["Particle Wave Options", "Subsubsection",
 CellChangeTimes->{{3.825085384609268*^9, 3.8250853960177813`*^9}, {
  3.8250917711582623`*^9, 3.825091774488023*^9}, {3.82509256741501*^9, 
  3.825092579209895*^9}, {3.825092668622217*^9, 3.8250926781397963`*^9}, {
  3.825093209489626*^9, 
  3.825093224891117*^9}},ExpressionUUID->"1325e0fe-37bb-4ee6-97d5-\
f0dbe3b8728b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"wavelength", "=", "30"}], ";"}], 
  "                                                                           \
                         ", 
  RowBox[{"(*", 
   RowBox[{"Wave", " ", "packet", " ", "wavelength", " ", "in", " ", "nm"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"s", "=", "20"}], ";"}], 
  "                                                                           \
                                              ", 
  RowBox[{"(*", 
   RowBox[{"Wave", " ", "packet", " ", "width", " ", 
    RowBox[{"(", 
     RowBox[{"standard", " ", "deviation"}], ")"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wavecentre", "=", "250"}], ";"}], 
  "                                                                           \
                       ", 
  RowBox[{"(*", 
   RowBox[{
   "Central", " ", "position", " ", "of", " ", "the", " ", "wave", " ", 
    "packet", " ", "in", " ", "nm"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wavecentreindex", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{"Round", "[", "x", "]"}], ",", "wavecentre"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "             ", 
  RowBox[{"(*", 
   RowBox[{
   "Grid", " ", "index", " ", "corresponding", " ", "to", " ", "wavecentre"}],
    "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", 
    RowBox[{"2", "*", 
     RowBox[{"Pi", "/", "wavelength"}]}]}], ";"}], 
  "                                                                           \
             ", 
  RowBox[{"(*", 
   RowBox[{"Wave", " ", "number"}], "*)"}]}], "\n"}], "Input",
 CellChangeTimes->{{3.8250846271260843`*^9, 3.8250846589999037`*^9}, {
   3.825091739340645*^9, 3.825091802302657*^9}, {3.8250920325404253`*^9, 
   3.825092033308013*^9}, {3.825092071634371*^9, 3.8250920726232557`*^9}, 
   3.8250924989922123`*^9, {3.825092583019886*^9, 3.825092586559683*^9}, {
   3.825092624400504*^9, 3.825092640013155*^9}, {3.825092686045269*^9, 
   3.8250928210765123`*^9}, {3.825093024447071*^9, 3.8250931090141582`*^9}, 
   3.825093168169798*^9, {3.825093227023883*^9, 3.825093294879318*^9}, {
   3.825093367906664*^9, 3.825093435830847*^9}, {3.825093533606016*^9, 
   3.825093562117766*^9}, {3.825093621378903*^9, 3.8250936401176233`*^9}, {
   3.825094194575144*^9, 3.825094206310944*^9}, 3.8251386947823563`*^9, {
