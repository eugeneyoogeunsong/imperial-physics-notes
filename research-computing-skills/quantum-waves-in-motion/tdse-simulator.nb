Cell[CellGroupData[{

Cell[TextData[StyleBox["2. Simulation Framework and Finite-Difference \
Propagation of\n     Quantum Wavefunctions",
 FontSize->36,
 FontWeight->"Bold"]], "Chapter",
 CellChangeTimes->{{3.82507144496264*^9, 3.8250714486037617`*^9}, {
  3.9522755742279778`*^9, 3.9522755744851227`*^9}, {3.952275778029807*^9, 
