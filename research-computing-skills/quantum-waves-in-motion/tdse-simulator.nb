   3.825141575357128*^9}, {3.82514170075686*^9, 3.8251418299449177`*^9}, {
   3.825142038240732*^9, 3.825142041871175*^9}, {3.825142075703476*^9, 
   3.825142087619987*^9}, {3.825142278266507*^9, 3.8251423326041107`*^9}, {
   3.825142604764213*^9, 3.825142637678522*^9}, {3.825143932244755*^9, 
   3.825143956523532*^9}, {3.82514413437782*^9, 3.825144136522636*^9}, 
   3.8251442777139673`*^9, {3.825144417227062*^9, 3.825144437667776*^9}, {
   3.825144475034544*^9, 3.82514450380645*^9}, {3.825144879860631*^9, 
