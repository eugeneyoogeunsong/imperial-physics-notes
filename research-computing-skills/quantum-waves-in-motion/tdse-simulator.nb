   3.825093364398036*^9}, {3.825139309360332*^9, 3.825139326165794*^9}, {
   3.825144607061068*^9, 3.8251446081087427`*^9}, {3.8251454969733477`*^9, 
   3.8251454975142193`*^9}, 3.8253343552531443`*^9, {3.825344069758966*^9, 
