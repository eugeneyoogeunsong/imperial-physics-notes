   RowBox[{"potential", "=", "\"\<step\>\""}], ";"}], 
  "                                         ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Select", " ", "potential", " ", 
     RowBox[{"type", ":", "\"\<free\>\""}]}], ",", "\"\<square\>\"", 
