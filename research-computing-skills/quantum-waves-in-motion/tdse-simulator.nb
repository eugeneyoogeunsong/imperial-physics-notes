Cell[CellGroupData[{

Cell[TextData[StyleBox["Interactive Simulation Dashboard",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825604543860984*^9, 3.825604580309246*^9}, {
  3.9519948045090218`*^9, 3.95199481300589*^9}, {3.9519948548478107`*^9, 
  3.951994860711769*^9}},ExpressionUUID->"2a4bd0fd-5436-4bd9-8c4f-\
b59151ffba7a"],

Cell[TextData[{
 StyleBox["This interactive dashboard allows users to explore the effects of \
varying simulation parameters in real time. Using ",
  FontSize->16],
 StyleBox["DynamicModule",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[", the dashboard provides sliders for adjusting key parameters such \
as the time step ",
  FontSize->16],
 StyleBox["dt",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[", well height, and wavepacket width ",
  FontSize->16],
 StyleBox["s",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[". When these parameters are changed, the simulation is re-run, and \
the resulting expectation value of the position ",
  FontSize->16],
 StyleBox["(\:27e8x\:27e9(t))",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" is updated immediately. This interactivity not only enhances user \
engagement but also deepens understanding of how changes in physical \
parameters influence the dynamics of the quantum system. A status indicator \
or message can be added to provide feedback during the simulation run, \
ensuring that users are aware of the computation\[CloseCurlyQuote]s progress.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.951994868869054*^9, 3.951994870028061*^9}, {
  3.952274418209572*^9, 
  3.95227442279795*^9}},ExpressionUUID->"11920a11-6cea-457b-a61b-\
a7dcda38e059"],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"userResult", ",", "times", ",", "RtFrames", ",", "ItFrames"}], 
    "}"}], ",", 
   RowBox[{"(*", 
    RowBox[{
    "Assume", " ", "potentialUser", " ", "is", " ", "already", " ", "defined",
      " ", "and", " ", "the", " ", "simulation", " ", "has", " ", "been", " ",
      "run"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"userResult", "=", 
     RowBox[{"timeEvolutionEuler", "[", 
      RowBox[{"R0", ",", "I0", ",", "potentialUser"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Extract", " ", "saved", " ", "time", " ", "stamps", " ", "and", " ", 
      "wavefunction", " ", "snapshots"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"times", "=", 
     RowBox[{"userResult", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"RtFrames", "=", 
     RowBox[{"userResult", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"ItFrames", "=", 
     RowBox[{"userResult", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Animate", " ", "the", " ", "evolution", " ", "of", " ", "the", " ", 
       "probability", " ", "density"}], "|", 
      RowBox[{"\[CapitalPsi]", 
       RowBox[{"(", 
        RowBox[{"x", ",", "t"}], ")"}]}], "|", "\.b2"}], "*)"}], 
    RowBox[{"Animate", "[", 
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"RtFrames", "[", 
              RowBox[{"[", "frame", "]"}], "]"}], "^", "2"}], "+", 
            RowBox[{
             RowBox[{"ItFrames", "[", 
              RowBox[{"[", "frame", "]"}], "]"}], "^", "2"}]}]}], "}"}], 
         "]"}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"\"\<Probability Density at t = \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"times", "[", 
              RowBox[{"[", "frame", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"3", ",", "2"}], "}"}]}], "]"}], "]"}], 
          "<>", "\"\< s\>\""}]}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Position x (nm)\>\"", ",", "\"\<P(x)\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"ImageSize", "->", "Medium"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"frame", ",", "1", ",", 
        RowBox[{"Length", "[", "times", "]"}], ",", "1"}], "}"}]}], "]"}]}]}],
   "]"}]], "Input",
 CellChangeTimes->{{3.9519844724659777`*^9, 3.95198447246966*^9}, 
   3.951992840192231*^9, {3.952271743693961*^9, 3.952271752688161*^9}, {
   3.952272523696262*^9, 3.952272532387319*^9}, {3.952276912341167*^9, 
   3.952276912786015*^9}, {3.9522772867260523`*^9, 3.952277298131383*^9}, {
   3.952277353454953*^9, 3.952277353654711*^9}, {3.952277500709484*^9, 
   3.9522775273037767`*^9}, {3.952291567881014*^9, 3.952291574088315*^9}, {
   3.952435440144979*^9, 3.952435448282666*^9}, {3.952513593369122*^9, 
   3.9525136216262703`*^9}},
 FontSize->14,
 Background->RGBColor[1, 0.9, 0.8],
 CellLabel->"In[73]:=",ExpressionUUID->"d98d5885-7fe1-4725-ab94-fe64bb685d6a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Advanced Visualisations \[Dash] Phase\:2011Space and \
Frequency Analysis",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825604543860984*^9, 3.825604580309246*^9}, {
  3.9519948045090218`*^9, 3.95199481300589*^9}, {3.9519948548478107`*^9, 
  3.951994860711769*^9}, {3.951994914367132*^9, 
  3.951994920488723*^9}},ExpressionUUID->"f2b38c39-97ec-4ce2-a84b-\
92462f014976"],

Cell[TextData[{
 StyleBox["These final visualisation cells implement advanced analysis tools \
to further explore the quantum dynamics. One cell defines a ",
  FontSize->16],
 StyleBox["Wigner function",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[", which provides a quasi-probability distribution in phase space \
(momentum vs. position), and then uses ",
  FontSize->16],
 StyleBox["Animate",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" to create a dynamic visualisation of the phase-space evolution. \
This representation can reveal details about the momentum distribution and \
interference effects that are not immediately visible in position-space \
plots. Another cell employs the ",
  FontSize->16],
 StyleBox["Periodogram",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" function within a ",
  FontSize->16],
 StyleBox["Manipulate",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" to allow interactive frequency spectrum analysis of the \
wavefunction over a selected spatial region. This analysis can uncover the \
underlying energy and momentum content of the wavepacket, offering \
complementary insights into the behavior of the system under different \
potential conditions.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{
  3.951994929211418*^9, {3.952271804789652*^9, 
   3.952271814598691*^9}},ExpressionUUID->"ddc33d6b-2474-4782-b6fa-\
374d0da47414"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Define", " ", "the", " ", "Wigner", " ", "function", " ", "for", " ", 
     "phase"}], "-", 
    RowBox[{"space", " ", "analysis"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"WignerFunction", "[", "\[Psi]_", "]"}], ":=", 
     RowBox[{"Re", "[", 
      RowBox[{"Fourier", "[", 
       RowBox[{"\[Psi]", "*", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"Reverse", "[", "\[Psi]", "]"}], "]"}]}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Animate", " ", "the", " ", "phase"}], "-", 
     RowBox[{
     "space", " ", "dynamics", " ", "using", " ", "the", " ", "current", " ", 
      "wavefunction"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Animate", "[", 
     RowBox[{
      RowBox[{"ListDensityPlot", "[", 
       RowBox[{
        RowBox[{"WignerFunction", "[", 
         RowBox[{
          RowBox[{"RtFrames", "[", 
           RowBox[{"[", "frameIndex", "]"}], "]"}], "+", 
          RowBox[{"I", "*", 
           RowBox[{"ItFrames", "[", 
            RowBox[{"[", "frameIndex", "]"}], "]"}]}]}], "]"}], ",", 
        RowBox[{"PlotLabel", "->", "\"\<Phase\:2011Space Dynamics\>\""}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Momentum\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"frameIndex", ",", "1", ",", 
        RowBox[{"Length", "[", "RtFrames", "]"}], ",", "1"}], "}"}]}], "]"}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.951984723869804*^9, 3.9519847238727503`*^9}, 
   3.951992874500329*^9, 3.951994909910736*^9},
 FontSize->14,
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->"In[91]:=",ExpressionUUID->"30b00ae4-f91d-4ea9-b978-6524d5d8c4fd"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Periodogram", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Rt", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Center", "-", "10"}], ";;", 
          RowBox[{"Center", "+", "10"}]}], "]"}], "]"}], "^", "2"}], "+", 
      RowBox[{
       RowBox[{"It", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"Center", "-", "10"}], ";;", 
          RowBox[{"Center", "+", "10"}]}], "]"}], "]"}], "^", "2"}]}], ",", 
     RowBox[{"PlotLabel", "->", "\"\<Frequency Spectrum at Barrier\>\""}], ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"Center", ",", "11", ",", 
     RowBox[{"numgrid", "-", "10"}], ",", "1"}], "}"}]}], "  ", 
  RowBox[{"(*", 
   RowBox[{
   "Adjust", " ", "the", " ", "limits", " ", "as", " ", "needed", " ", "for", 
    " ", "your", " ", "grid"}], "*)"}], "]"}]], "Input",
 CellChangeTimes->{{3.9519847351023397`*^9, 3.951984735105558*^9}, {
  3.95227321222208*^9, 3.9522732170074244`*^9}, {3.9523395553112383`*^9, 
  3.952339556754511*^9}},
 FontSize->14,
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->"In[93]:=",ExpressionUUID->"9293bf7f-b282-46ea-8734-24690315b307"],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{
  3.9522758027221603`*^9},ExpressionUUID->"4d0154d5-b8f1-4de0-b835-\
ab0901b8d9b1"],

