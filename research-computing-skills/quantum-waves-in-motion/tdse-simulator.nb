   3.825145475226636*^9}, {3.8251456161274548`*^9, 3.8251456166452208`*^9}, {
   3.8251456991143208`*^9, 3.8251456992893963`*^9}, {3.8251457928951473`*^9, 
   3.825145800975235*^9}, {3.825145855158001*^9, 3.82514585576045*^9}, {
   3.825146195575165*^9, 3.825146215140978*^9}, {3.825146570245537*^9, 
   3.825146664995825*^9}, {3.825146698626542*^9, 3.8251467193416452`*^9}, {
   3.825146757263809*^9, 3.8251468482852488`*^9}, {3.825147189225296*^9, 
   3.825147192829032*^9}, 3.825246759005611*^9, {3.8252468113530483`*^9, 
   3.8252468214536247`*^9}, {3.825246990165835*^9, 3.8252470176142387`*^9}, {
   3.825247100278697*^9, 3.825247107641782*^9}, {3.8252473448453083`*^9, 
   3.825247439278811*^9}, 3.8252475071883287`*^9, 3.825247654860239*^9, {
