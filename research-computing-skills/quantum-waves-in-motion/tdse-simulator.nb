  3.952517105705118*^9}},ExpressionUUID->"8c3332ea-878c-4cbc-9ccb-\
c62aa6632092"],

Cell[TextData[{
 StyleBox["Here, you can use",
  FontSize->16],
 StyleBox[" choose the desired potential among  \[OpenCurlyDoubleQuote]free\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]square\
\[CloseCurlyDoubleQuote], \[OpenCurlyDoubleQuote]quadratic\
\[CloseCurlyDoubleQuote], and \[OpenCurlyDoubleQuote]step\
\[CloseCurlyDoubleQuote]. ",
  FontSize->16],
 StyleBox["Then, compute the time evolution of the wavefunction using the \
Euler method.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.8256051267265873`*^9, 3.825605155620741*^9}, {
  3.952271329401602*^9, 3.952271337516202*^9}, {3.9522720052873487`*^9, 
