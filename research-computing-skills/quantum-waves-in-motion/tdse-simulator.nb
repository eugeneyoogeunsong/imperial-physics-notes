Cell[TextData[{
 StyleBox["Physical Interpretation:\n",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["In this simulation, the particle approaches a step potential \
barrier and is subsequently reflected. The collision of the wave packet with \
the barrier leads to a temporary compression of the probability density. \
Additionally, an ",
  FontSize->18],
 StyleBox["exponential decay of the probability density",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox[" is observed within the barrier region, which is a hallmark of \
quantum ",
  FontSize->18],
 StyleBox["tunneling",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox[" phenomena.\n \n ",
  FontSize->18]
}], "Text",
 CellChangeTimes->{
  3.82560650664505*^9, {3.825660907774913*^9, 3.8256609286224613`*^9}, {
   3.825660974036133*^9, 3.825661037792686*^9}, {3.825661069340469*^9, 
   3.8256610699142017`*^9}, {3.9522706961522017`*^9, 3.95227070418545*^9}, {
   3.952270752117991*^9, 3.95227078340833*^9}, 
   3.952271995748012*^9},ExpressionUUID->"9169a342-b75d-49f9-a040-\
85530c7359d0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Customise Simulation Parameters: Potential and Wave \
Packet Settings",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825604543860984*^9, 3.825604580309246*^9}, {
  3.952270930019815*^9, 
  3.9522709354738007`*^9}},ExpressionUUID->"8dc00046-5083-4734-afb3-\
043fe78d65ea"],

Cell[TextData[{
 StyleBox["In this section, the ",
  FontSize->16],
 StyleBox["user",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" can adjust the parameters governing both the physical potential \
and the initial particle wave packet. These settings allow exploration of \
different behaviors in the simulation.\n\n",
  FontSize->16],
 StyleBox["You are encouraged to adjust the parameters below. The orange \
cells contain customisable settings for the physical potential (the \
\[OpenCurlyDoubleQuote]Physical Picture\[CloseCurlyDoubleQuote]) as well as \
for the initial wave packet (the \[OpenCurlyDoubleQuote]Particle Wave Options\
\[CloseCurlyDoubleQuote]). Altering these parameters will enable you to \
explore various dynamical behaviors in the simulation.",
  FontSize->18,
  FontWeight->"Bold",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.825604918364894*^9, 3.825605007408777*^9}, {
  3.8256050438652477`*^9, 3.825605083619104*^9}, {3.9522709157047567`*^9, 
  3.952271053908407*^9}, {3.952271409911065*^9, 
  3.9522714531619883`*^9}},ExpressionUUID->"c97e65ec-9ca6-4fa9-8e57-\
adb87c000c4b"],

Cell[CellGroupData[{

Cell["Physical Picture Options ", "Subsubsection",
 CellChangeTimes->{{3.825085384609268*^9, 3.8250853960177813`*^9}, {
  3.8250917711582623`*^9, 3.825091774488023*^9}, {3.82509256741501*^9, 
  3.825092579209895*^9}, {3.825092668622217*^9, 3.8250926781397963`*^9}, {
  3.8250932198068857`*^9, 
  3.825093220737073*^9}},ExpressionUUID->"37c1e4db-2d36-48b2-b9ee-\
82453c5ed7f6"],

