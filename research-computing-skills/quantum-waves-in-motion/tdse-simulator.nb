Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "the", " ", "time", " ", "evolution", " ", "of", " ", 
    "the", " ", "wavefunction", " ", "under", " ", "the", " ", "step", " ", 
    "potential", " ", "using", " ", "the", " ", "Euler", " ", 
    RowBox[{"method", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"stepResult", " ", "=", " ", 
    RowBox[{"timeEvolutionEuler", "[", 
     RowBox[{"R0", ",", " ", "I0", ",", " ", "potentialStep"}], "]"}]}], 
   ";"}]}]], "Input",
 CellDingbat->"\[WatchIcon]",
 CellChangeTimes->{{3.825592589181937*^9, 3.825592608243765*^9}, {
   3.8255934862715197`*^9, 3.8255935268271847`*^9}, {3.825593713263896*^9, 
