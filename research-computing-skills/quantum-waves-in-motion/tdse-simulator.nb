Cell[TextData[{
 StyleBox["Physical Interpretation: \n",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["The simulation shows that the free particle propagates at a ",
  FontSize->18],
 StyleBox["speed consistent with its wavevector",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox[". As time progresses, the wave packet naturally broadens due to \
dispersion, reflecting the quantum uncertainty in the particle\
\[CloseCurlyQuote]s position. This spreading indicates that, even without \
external forces, a free quantum particle becomes ",
  FontSize->18],
 StyleBox["less localised over time",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox[".",
  FontSize->18],
 StyleBox["\n",
  FontSize->16],
 StyleBox["\n",
  FontSize->18]
}], "Text",
 CellChangeTimes->{{3.825593050188308*^9, 3.825593069637232*^9}, {
  3.825593180474394*^9, 3.8255932423137817`*^9}, {3.825659557349297*^9, 
  3.825659625609002*^9}, {3.825660570284937*^9, 3.82566057719037*^9}, {
  3.95202346763125*^9, 3.9520235006452208`*^9}, {3.95227436434711*^9, 
  3.9522743644626102`*^9}},ExpressionUUID->"2f46aa4c-6b2a-44ef-b92d-\
b8b618659ea0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Finite Square Potential Well",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825588018836829*^9, 
  3.8255880278357553`*^9}},ExpressionUUID->"a45899ef-ac15-44ff-8c61-\
acdc02309092"],

Cell[TextData[{
 StyleBox["In this example, we explore a",
  FontSize->16],
 StyleBox[" finite square well ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["that traps a particle. The chosen initial wave corresponds to a ",
  FontSize->16],
 StyleBox["particle",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" with energy approximately half the well\[CloseCurlyQuote]s depth.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.825588032426358*^9, 3.82558817418211*^9}, 
   3.952023589770255*^9},ExpressionUUID->"ba8f5ce6-2c8b-49a3-8e99-\
e5d0e8765695"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"We", " ", "retrieve", " ", "the", " ", "square", " ", "well", " ", 
    RowBox[{"potential", "."}]}], "*)"}], "\[IndentingNewLine]", 
  "                 ", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"shift", "=", "0"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"No", " ", "horizontal", " ", "shift"}], ";", " ", 
     RowBox[{"potential", " ", "is", " ", "centered"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wellwidth", "=", "100"}], ";"}], "    ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"squarePotential", " ", "=", 
     RowBox[{"choosePotential", "[", "\"\<square\>\"", "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.825588202195941*^9, 3.825588213978767*^9}, {
  3.825588256414103*^9, 3.825588257812793*^9}, {3.825592603559998*^9, 
  3.8255926044404507`*^9}, {3.9520237692756042`*^9, 3.952023788400838*^9}, {
  3.9522671901730824`*^9, 3.9522671916267014`*^9}, {3.952505223472534*^9, 
  3.9525052413638983`*^9}, {3.9525053263275137`*^9, 3.952505326940099*^9}},
 FontSize->14,
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"28263981-9521-4457-a67e-bf3f7da7b59d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "wavefunction", " ", "is", " ", "evolved", " ", "using", " ", 
     "the", " ", "basic", " ", "time", " ", "evolution", " ", "function", " ",
      "with", " ", "the", " ", "square", " ", "well", " ", "potential"}], ",", 
    RowBox[{"generating", " ", "intermediate", " ", "states", " ", "over", " ", 
     RowBox[{"time", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"squareResult", " ", "=", " ", 
    RowBox[{"timeEvolutionEuler", "[", 
     RowBox[{"R0", ",", " ", "I0", ",", " ", "squarePotential"}], "]"}]}], 
   ";"}]}]], "Input",
 CellDingbat->"\[WatchIcon]",
 CellChangeTimes->{{3.825592589181937*^9, 3.825592608243765*^9}, {
  3.9520237915819893`*^9, 3.9520238175857563`*^9}, {3.9522671950044327`*^9, 
  3.952267196228469*^9}, {3.952434349317958*^9, 3.952434352462586*^9}},
 FontSize->14,
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->"In[82]:=",ExpressionUUID->"2114de3b-5c2a-47ff-a74f-43248fb01077"],

Cell[TextData[{
 StyleBox["Optional:",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" You can also compute the time evolution using the ",
  FontSize->16],
 StyleBox["RK4",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" method via ",
  FontSize->16],
 StyleBox["timeEvolutionRK4",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" function provided below. However, I recommend using the ",
  FontSize->16],
 StyleBox["Euler",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" method above instead, as it is more expedient and error-free.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.82558828010322*^9, 3.825588326079934*^9}, {
   3.952276001021229*^9, 3.9522760050012417`*^9}, {3.9522760443728027`*^9, 
