Cell[CellGroupData[{

Cell[TextData[StyleBox["Initial Wavefunction",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825139422854247*^9, 
  3.82513942673468*^9}},ExpressionUUID->"ca7ebb2b-903c-473f-8fa8-\
e186c6da2ff2"],

Cell[TextData[{
 "In this segment, we construct the starting wavefunction for our simulation. \
We create two arrays\[LongDash]one for the real part and one for the \
imaginary part\[LongDash]each initialised to zero across the spatial grid. \
For each grid point, we compute the wavefunction by applying a ",
 StyleBox["Gaussian envelope",
  FontWeight->"Bold"],
 " (which ensures spatial localisation) combined with cosine and sine factors \
to encode the phase information and momentum. After obtaining these values, \
we normalise the wavefunction according to the Born probability rule, \
ensuring that the total probability sums to ",
 StyleBox["unity",
  FontWeight->"Bold"],
 ". This normalised state forms the basis for all subsequent time evolution."
}], "Text",
 CellChangeTimes->{{3.825139455783435*^9, 3.825139480165207*^9}, {
  3.8256594069407682`*^9, 3.8256594201992817`*^9}, {3.952013491525866*^9, 
  3.952013503638434*^9}},ExpressionUUID->"8a736bce-eaea-4d84-9c9d-\
438ccb7dd670"],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{"Initialise", " ", "the", " ", "wavefunction", " ", "arrays"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"R0", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Length", "[", "x", "]"}]}], "]"}]}], ";"}], "   ", 
    RowBox[{"(*", 
     RowBox[{
     "Array", " ", "to", " ", "hold", " ", "the", " ", "real", " ", "part", " ",
       "of", " ", "the", " ", "wavefunction"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"I0", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Length", "[", "x", "]"}]}], "]"}]}], ";"}], "   ", 
    RowBox[{"(*", 
     RowBox[{
     "Array", " ", "to", " ", "hold", " ", "the", " ", "imaginary", " ", 
      "part", " ", "of", " ", "the", " ", "wavefunction"}], "*)"}], "\n", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Compute", " ", "the", " ", "initial", " ", "wavefunction", " ", "at", " ",
       "each", " ", "grid", " ", "point"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"nx", "=", "1"}], ",", 
      RowBox[{"nx", "<=", "numgrid"}], ",", 
      RowBox[{"nx", "++"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"R0", "[", 
         RowBox[{"[", "nx", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "0.5"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "nx", "]"}], "]"}], "-", 
                RowBox[{"x", "[", 
                 RowBox[{"[", "wavecentreindex", "]"}], "]"}]}], ")"}], "/", 
              "s"}], ")"}], "^", "2"}]}], "]"}], "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"k", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", "nx", "]"}], "]"}], "-", 
             RowBox[{"x", "[", 
              RowBox[{"[", "wavecentreindex", "]"}], "]"}]}], ")"}]}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"I0", "[", 
         RowBox[{"[", "nx", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "0.5"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "nx", "]"}], "]"}], "-", 
                RowBox[{"x", "[", 
                 RowBox[{"[", "wavecentreindex", "]"}], "]"}]}], ")"}], "/", 
              "s"}], ")"}], "^", "2"}]}], "]"}], "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"k", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", "nx", "]"}], "]"}], "-", 
             RowBox[{"x", "[", 
              RowBox[{"[", "wavecentreindex", "]"}], "]"}]}], ")"}]}], 
          "]"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{"(*", 
     RowBox[{
     "Normalise", " ", "the", " ", "wavefunction", " ", "using", " ", "the", " ",
       "Born", " ", "rule"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"modulus", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"R0", "^", "2"}], "+", 
             RowBox[{"I0", "^", "2"}]}], ")"}]}], "}"}], "]"}], ",", 
        RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{
     RowBox[{"A", "=", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"modulus", "[", "xval", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"xval", ",", "0", ",", "L"}], "}"}]}], "]"}]}], ";"}], "\n", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Scale", " ", "the", " ", "initial", " ", "wavefunction", " ", "to", " ",
       "ensure", " ", "total", " ", "probability", " ", "equals", " ", "1"}], 
     "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"R0", "=", 
      RowBox[{"R0", "/", 
       RowBox[{"Sqrt", "[", "A", "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"I0", "=", 
      RowBox[{"I0", "/", 
       RowBox[{"Sqrt", "[", "A", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Verify", " ", "normalisation"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"modulusNormalised", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"R0", "^", "2"}], "+", 
             RowBox[{"I0", "^", "2"}]}], ")"}]}], "}"}], "]"}], ",", 
        RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], "\n", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"modulusNormalised", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "L"}], "}"}]}], "]"}]}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{
  3.8251394976918983`*^9, {3.8251395614368467`*^9, 3.825139640716217*^9}, {
   3.8251399651242857`*^9, 3.825140005756061*^9}, {3.825140036940702*^9, 
