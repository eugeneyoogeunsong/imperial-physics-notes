Cell[CellGroupData[{
Cell[TextData[StyleBox["Quantum Waves in Motion: Numerical Modeling of the \
Time-Dependent Schr\[ODoubleDot]dinger Equation",
 FontSize->48]], "Title",
 CellChangeTimes->{{3.8250708694133987`*^9, 3.825070870830256*^9}, {
  3.8250709013849583`*^9, 3.825070932952986*^9}, {3.9510936684799*^9, 
