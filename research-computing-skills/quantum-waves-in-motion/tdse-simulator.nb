Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{"Construct", " ", "the", " ", "spatial", " ", "grid"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"x", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"0", ",", "L", ",", 
        RowBox[{"numgrid", "-", "1"}]}], "]"}]}], ";"}], "     ", 
    RowBox[{"(*", 
     RowBox[{
     "Create", " ", "a", " ", "linear", " ", "grid", " ", "from", " ", "0", " ",
       "to", " ", "L"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"dx", "=", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "-", 
       RowBox[{"x", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], 
    "                                          ", 
    RowBox[{"(*", 
     RowBox[{
     "Calculate", " ", "the", " ", "spacing", " ", "between", " ", 
      "consecutive", " ", "grid", " ", "points"}], "*)"}], 
    "\[IndentingNewLine]"}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.825092105668253*^9, 3.825092146365933*^9}, {
   3.825092435357079*^9, 3.825092508148882*^9}, 3.82509370639142*^9, {
