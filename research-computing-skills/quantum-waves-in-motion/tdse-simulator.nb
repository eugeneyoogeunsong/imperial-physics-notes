     RowBox[{"Evaluate", "[", "freePlots", "]"}], ",", 
     RowBox[{"DefaultDuration", "\[Rule]", "7"}], ",", " ", 
     RowBox[{"AnimationRepetitions", "\[Rule]", "1"}], ",", 
     RowBox[{"DisplayAllSteps", "->", "True"}]}], "]"}]}]}]], "Input",
