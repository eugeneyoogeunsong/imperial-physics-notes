Cell[CellGroupData[{

Cell[TextData[StyleBox["3. Quantum Dynamics in Action: Simulating Time \
Evolution Across\n     Diverse Potential Landscapes",
 FontSize->36,
 FontWeight->"Bold"]], "Chapter",
 CellChangeTimes->{{3.825587694655691*^9, 3.8255877627420483`*^9}, 
   3.9520232961212*^9, {3.9522755833654137`*^9, 3.9522755836314993`*^9}, {
   3.952275875799665*^9, 3.9522758758650312`*^9}, {3.952275926899982*^9, 
   3.952275930742573*^9}},ExpressionUUID->"2b3a00ea-4f05-4e67-bf2f-\
c1df55ad6a83"],

Cell[TextData[{
 StyleBox["In this section, we investigate how an ",
  FontSize->16],
 StyleBox["electron\[CloseCurlyQuote]s wavefunction evolves over time under \
various potential landscapes",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[". We begin with a free particle case, where the potential is zero, \
and use the time evolution functions to propagate the initial state. The \
generated plots and animations illustrate key quantum behaviors, providing a \
basis for further exploration and experimentation with different potentials.",
  
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.825587794416437*^9, 3.825587975649445*^9}, {
  3.825659527482869*^9, 3.825659532280632*^9}, {3.952023293456971*^9, 
  3.952023323519764*^9}},ExpressionUUID->"3315502f-e238-46ea-91f4-\
6d6a816ea423"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Free Particle",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825588272461651*^9, 
  3.825588275048895*^9}},ExpressionUUID->"920e74f6-6b5e-4970-86ee-\
681090deed1c"],

Cell[TextData[{
 StyleBox["Initially, we examine the simplest case\[LongDash]a",
  FontSize->16],
 StyleBox[" free particle",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" in the absence of any external potential, where ",
  FontSize->16],
 StyleBox["V(x) = 0",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[". In this scenario, the wavefunction evolves purely under the \
influence of its kinetic energy. This baseline simulation allows us to \
validate the propagation mechanics of our numerical scheme and to observe the \
natural dispersion of the quantum wave packet without any external forces \
interfering.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.82558828010322*^9, 3.825588326079934*^9}, {
  3.952276001021229*^9, 3.9522760050012417`*^9}, {3.9522760443728027`*^9, 
  3.952276056789324*^9}},ExpressionUUID->"7517d4b2-a2de-4721-a83a-\
e20b9593fb79"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
    "Retrieve", " ", "the", " ", "free", " ", "particle", " ", "potential", " ",
      "using", " ", 
     RowBox[{
      RowBox[{"choosePotential", "[", "\"\<free\>\"", "]"}], "."}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freePotential", " ", "=", 
     RowBox[{"choosePotential", "[", "\"\<free\>\"", "]"}]}], ";"}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.825588358562739*^9, 3.825588378486361*^9}, {
   3.8255884507872334`*^9, 3.8255884519965067`*^9}, {3.825588551653172*^9, 
   3.82558859449289*^9}, {3.9520233527412033`*^9, 3.952023358065877*^9}, 
   3.95219646743736*^9, 3.952254415168964*^9, {3.9522647184607983`*^9, 
   3.952264720430011*^9}, {3.9522658142895393`*^9, 3.9522658168949137`*^9}},
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->
  "In[200]:=",ExpressionUUID->"9829cf06-4779-40aa-ae44-119703a14825"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Compute", " ", "the", " ", "wavefunction"}], 
      "\[CloseCurlyQuote]"}], "s", " ", "time", " ", "evolution", " ", "with",
      " ", "the", " ", "timeEvolutionEuler", " ", 
     RowBox[{"function", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freeResult", " ", "=", " ", 
     RowBox[{"timeEvolutionEuler", "[", 
      RowBox[{"R0", ",", " ", "I0", ",", " ", "freePotential"}], "]"}]}], 
    ";"}]}],
  FontSize->14]], "Input",
 CellDingbat->"\[WatchIcon]",
 CellChangeTimes->{{3.825588597280776*^9, 3.825588626713407*^9}, {
  3.825588725703959*^9, 3.825588726661762*^9}, {3.952023371290928*^9, 
  3.952023386507371*^9}, {3.952264726628385*^9, 3.952264727130787*^9}, {
  3.952265803634839*^9, 3.952265804870347*^9}, {3.952434324763421*^9, 
  3.952434328109776*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"c3e663f1-dd9a-4040-b55f-6120f7233619"],

Cell[TextData[{
 StyleBox["Optional:",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" You can also compute the time evolution using the ",
  FontSize->16],
 StyleBox["RK4",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" method via ",
  FontSize->16],
 StyleBox["timeEvolutionRK4",
  FontSize->16,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" function provided below. However, I recommend using the ",
  FontSize->16],
 StyleBox["Euler",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" method above instead, as it is more expedient and error-free.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.82558828010322*^9, 3.825588326079934*^9}, {
   3.952276001021229*^9, 3.9522760050012417`*^9}, {3.9522760443728027`*^9, 
   3.952276056789324*^9}, {3.9525107794788857`*^9, 3.9525108088652267`*^9}, {
   3.9525108425463877`*^9, 3.95251091556497*^9}, {3.952510946910345*^9, 
   3.952510980939424*^9}, {3.952511022871237*^9, 3.952511039134108*^9}, 
   3.952511341910028*^9, {3.9525166057925453`*^9, 
   3.952516609714087*^9}},ExpressionUUID->"ae0e1aa8-74f6-4af4-8f7e-\
94d25e8abb79"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Compute", " ", "the", " ", "wavefunction"}], 
      "\[CloseCurlyQuote]"}], "s", " ", "time", " ", "evolution", " ", "with",
      " ", "the", " ", "timeEvolutionRK4", " ", 
     RowBox[{"function", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freeResult", " ", "=", " ", 
     RowBox[{"timeEvolutionRK4", "[", 
      RowBox[{"R0", ",", " ", "I0", ",", " ", "freePotential"}], "]"}]}], 
    ";"}]}],
  FontSize->14]], "Input",
 CellDingbat->"\[WatchIcon]",
 CellChangeTimes->{{3.825588597280776*^9, 3.825588626713407*^9}, {
  3.825588725703959*^9, 3.825588726661762*^9}, {3.952023371290928*^9, 
