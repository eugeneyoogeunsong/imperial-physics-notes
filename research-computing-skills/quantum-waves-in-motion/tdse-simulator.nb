Cell[TextData[{
 StyleBox["Physical Interpretation:\n",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["In this simulation, the particle is confined within a ",
  FontSize->18],
 StyleBox["finite potential well",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox[". As the wave packet reaches the right boundary of the well, it is \
reflected and undergoes oscillatory motion within the well. Notably, a \
fraction of the probability density penetrates the barrier region, \
illustrating the phenomenon of quantum ",
  FontSize->18],
 StyleBox["tunneling",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox[".",
  FontSize->18],
 StyleBox["\n",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["\n",
  FontSize->18,
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{
  3.825606486754683*^9, {3.825659682643529*^9, 3.8256597530104723`*^9}, {
   3.82565981451478*^9, 3.8256598252237673`*^9}, {3.825659861337089*^9, 
   3.825659874663286*^9}, {3.825660595028644*^9, 3.825660629136341*^9}, {
   3.9522698942527742`*^9, 3.952269897689897*^9}, {3.952269944284912*^9, 
   3.952269947366927*^9}},ExpressionUUID->"468455ed-fffe-462e-a0d0-\
7e9d217d4bb1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Quadratic (Harmonic) Potential Well",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825588018836829*^9, 3.8255880278357553`*^9}, {
  3.82559280574998*^9, 3.8255928129441957`*^9}, {3.952270036675596*^9, 
  3.952270039258314*^9}},ExpressionUUID->"1e917e0e-4c6a-40fe-978e-\
691774ad9989"],

Cell[TextData[{
 StyleBox["In this simulation, we explore the behavior of a ",
  FontSize->16],
 StyleBox["bound particle",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" in an idealised ",
  FontSize->16],
 StyleBox["harmonic",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" potential, one of the most common models in quantum mechanics. \
Doubling the well width accentuates interesting dynamics, such as enhanced \
oscillations, dispersion, and interference effects.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.82559282045891*^9, 3.825592904136395*^9}, {
  3.82559293489954*^9, 3.825592934907589*^9}, {3.825593428214449*^9, 
  3.825593452589876*^9}, {3.825663823847687*^9, 3.825663846873498*^9}, {
  3.952270027514369*^9, 
  3.9522700498197117`*^9}},ExpressionUUID->"4acc0184-6ddb-45b2-a45a-\
51f55eee3924"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "parameters", " ", "for", " ", "the", " ", 
    "harmonic", " ", 
    RowBox[{"(", "quadratic", ")"}], " ", 
    RowBox[{"potential", ":", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"-", "Set"}], " ", "shift", " ", "to", " ", "0", " ", "so", " ",
       "that", " ", "the", " ", "potential", " ", "is", " ", 
      RowBox[{"centered", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"shift", "=", "0"}], ";"}], "                   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"No", " ", "horizontal", " ", "shift"}], ";", " ", 
     RowBox[{"potential", " ", "is", " ", "centered"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wellwidth", "=", "200"}], ";"}], "     ", 
   RowBox[{"(*", 
    RowBox[{
    "Increase", " ", "the", " ", "well", " ", "width", " ", "to", " ", "200", 
     " ", "to", " ", "allow", " ", "for", " ", "more", " ", "pronounced", " ",
      "dynamical", " ", 
     RowBox[{"behavior", "."}]}], "*)"}], " ", "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"potentialQuadratic", "=", 
     RowBox[{"choosePotential", "[", "\"\<quadratic\>\"", "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Retrieve", " ", "the", " ", "quadratic", " ", "potential", " ", "from", " ",
      "the", " ", "potential", " ", 
     RowBox[{"library", "."}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.825588202195941*^9, 3.825588213978767*^9}, {
   3.825588256414103*^9, 3.825588257812793*^9}, {3.825592603559998*^9, 
   3.8255926044404507`*^9}, {3.825593480322283*^9, 3.825593504753121*^9}, {
   3.825663732312703*^9, 3.8256637409066677`*^9}, {3.825663810375608*^9, 
   3.825663821424429*^9}, {3.825663852912138*^9, 3.8256638546686*^9}, {
   3.82566514024601*^9, 3.8256651737553577`*^9}, {3.952267239014983*^9, 
   3.952267254014078*^9}, {3.952270053307644*^9, 3.952270058058201*^9}, {
   3.952270332501457*^9, 3.9522703347204933`*^9}, {3.9522704432519703`*^9, 
   3.952270497177208*^9}, 3.9522723817760572`*^9, 3.952291987819623*^9, 
   3.952505323435348*^9},
 FontSize->14,
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"ab132741-db04-4b75-8d2d-e195d1ac9f20"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "the", " ", "time", " ", "evolution", " ", "of", " ", 
    "the", " ", "wavefunction", " ", "using", " ", "the", " ", "Euler", " ", 
    RowBox[{"method", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
