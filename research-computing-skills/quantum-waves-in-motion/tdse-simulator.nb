Cell[CellGroupData[{

Cell[TextData[StyleBox["Physical Constants",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825084075731982*^9, 3.8250840893431263`*^9}, 
   3.9520116358616133`*^9},ExpressionUUID->"744cc1f1-33bc-470a-abbc-\
b5e4b532bff5"],

Cell[TextData[{
 StyleBox["In this section, we define all fundamental physical constants \
required for the simulation. We set the mass of the electron (",
  FontSize->16],
 StyleBox["me",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["), the reduced Planck constant (",
  FontSize->16],
 StyleBox["hbar",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["), and the full Planck constant (",
  FontSize->16],
 StyleBox["h",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["), along with the elementary charge (",
  FontSize->16],
 StyleBox["e",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["). These constants establish the correct units for all subsequent \
calculations. ",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.951993282207642*^9, 3.951993318816387*^9}, {
  3.9520131114544897`*^9, 
  3.952013113144972*^9}},ExpressionUUID->"e31054d9-f8c4-41ea-8262-\
55b12dd58dbb"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{"Assign", " ", "important", " ", "physical", " ", "constants"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"me", "=", 
      RowBox[{"9.109", "*", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", "31"}], ")"}]}]}]}], ";"}], 
    "                             ", "\[IndentingNewLine]", 
    "\t\t\t\t\t       ", 
    RowBox[{"(*", 
     RowBox[{
     "Mass", " ", "of", " ", "the", " ", "electron", " ", "in", " ", "kg"}], 
     "*)"}], "\n", 
    RowBox[{
     RowBox[{"hbar", "=", 
      RowBox[{"1.0545", "*", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", "34"}], ")"}]}], "*", 
       RowBox[{"10", "^", 
        RowBox[{"(", "18", ")"}]}]}]}], ";"}], "     ", "\[IndentingNewLine]",
     "\t\t\t\t                ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"Reduced", " ", "Planck"}], "\[CloseCurlyQuote]"}], "s", " ", 
      "constant", " ", "in", " ", 
      RowBox[{"nm", "^", "2"}], " ", "kg", " ", 
      RowBox[{"s", "^", 
       RowBox[{"-", "1"}]}]}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"h", "=", 
      RowBox[{"hbar", "*", "2", "*", "Pi"}]}], ";"}], "                    ", 
    
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"Planck", "\[CloseCurlyQuote]"}], "s", " ", "constant", " ", 
      "in", " ", 
      RowBox[{"nm", "^", "2"}], " ", "kg", " ", 
      RowBox[{"s", "^", 
       RowBox[{"-", "1"}]}]}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"e", "=", 
      RowBox[{"1.602", "*", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"-", "19"}], ")"}]}]}]}], ";"}], "  ", "\[IndentingNewLine]",
     "\t\t\t\t\t      ", 
    RowBox[{"(*", 
     RowBox[{
     "Elementary", " ", "electric", " ", "charge", " ", "in", " ", 
      "Coulombs"}], "*)"}]}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.825084094327045*^9, 3.825084116201952*^9}, {
   3.825084173684614*^9, 3.825084311092534*^9}, {3.825084377116362*^9, 
   3.825084560661364*^9}, {3.825084854761263*^9, 3.825084880951703*^9}, {
