Cell[TextData[{
 StyleBox["Physical Interpretation: \n",
  FontSize->18,
  FontWeight->"Bold"],
 StyleBox["In this simulation, we observe the dynamics of a bound particle \
confined within a harmonic potential well. As the particle reaches the well \
boundary, it is strongly reflected, resulting in a pronounced oscillatory \
pattern in the wavefunction amplitudes. This oscillatory \
behavior\[LongDash]characterised by a distinct ",
  FontSize->18],
 StyleBox["\[OpenCurlyDoubleQuote]wiggling\[CloseCurlyDoubleQuote]",
  FontSize->18,
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox["of the amplitudes\[LongDash]illustrates the interference effects \
and inherent dynamics of a confined quantum state.\n\n",
  FontSize->18]
}], "Text",
 CellChangeTimes->{
  3.825606499227915*^9, 3.825660685626383*^9, {3.8256607172634068`*^9, 
   3.825660790021984*^9}, {3.95227008611765*^9, 3.9522700877625723`*^9}, {
   3.952270121916843*^9, 3.9522701347620697`*^9}, {3.9522701735060673`*^9, 
   3.952270173586108*^9}, {3.952270780160653*^9, 
   3.95227078024288*^9}},ExpressionUUID->"44cbebbf-2cf9-4efe-9eac-\
b01f863cec53"],

