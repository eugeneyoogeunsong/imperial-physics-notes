Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "evolution", " ", "data", " ", "is", " ", "then", " ", "used", 
    " ", "to", " ", "generate", " ", "a", " ", "series", " ", "of", " ", 
    "plots", " ", "for", " ", "each", " ", "saved", " ", "frame"}], "*)"}], 
