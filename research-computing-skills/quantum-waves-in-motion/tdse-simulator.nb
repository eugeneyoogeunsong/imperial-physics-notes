Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "timeEvolutionRK4"}]}], " ", "Function", " ", "with", " ",
       "Time", " ", "Tracking", " ", "using", " ", 
      RowBox[{"RK4", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"timeEvolutionRK4", "[", 
     RowBox[{"R0_", ",", "I0_", ",", "V_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"times", ",", "RtFrames", ",", "ItFrames", ",", "PtFrames"}], 
       "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"currentTime", "=", "0"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Initialise", " ", "the", " ", "wavefunctions", " ", "with", " ", 
         "the", " ", "initial", " ", "state"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Rt", "=", "R0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"It", "=", "I0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"times", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"RtFrames", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ItFrames", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"PtFrames", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{"(*", 
         RowBox[{
         "Update", " ", "the", " ", "wavefunction", " ", "using", " ", "RK4", 
          " ", "with", " ", "the", " ", "current", " ", "time"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Rt", ",", "It"}], "}"}], "=", 
           RowBox[{"RK4Step", "[", 
            RowBox[{
            "Rt", ",", "It", ",", "currentTime", ",", " ", "dtRescaled"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentTime", "+=", "dtRescaled"}], ";", 
          RowBox[{"(*", 
           RowBox[{"Increment", " ", "simulation", " ", "time"}], "*)"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Apply", " ", "absorbing", " ", "boundary", " ", "conditions", " ",
              "to", " ", "avoid", " ", "non"}], "-", 
            RowBox[{"physical", " ", "reflections"}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Rt", "=", 
           RowBox[{"AbsorbingBoundary", "[", "Rt", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"It", "=", 
           RowBox[{"AbsorbingBoundary", "[", "It", "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Save", " ", "frames", " ", "at", " ", "every", " ", "framestep"}],
            "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"nt", ",", "framestep"}], "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"RtFrames", ",", "Rt"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"ItFrames", ",", "It"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"times", ",", "currentTime"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Pt", "=", 
              RowBox[{
               RowBox[{"Rt", "^", "2"}], "+", 
               RowBox[{"It", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"PtFrames", ",", "Pt"}], "]"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"nt", ",", "1", ",", "ntimestep"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Package", " ", "and", " ", "return", " ", "the", " ", "result", " ", 
         "vector"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"times", ",", "RtFrames", ",", "ItFrames", ",", "PtFrames"}], 
        "}"}]}]}], "]"}]}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.952279390042308*^9, 3.9522793957573147`*^9}, {
  3.952279465159601*^9, 3.952279470838764*^9}, {3.9522910215216713`*^9, 
  3.952291046997485*^9}, {3.952291085437746*^9, 3.952291090131439*^9}, {
