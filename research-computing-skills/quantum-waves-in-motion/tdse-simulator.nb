Cell[CellGroupData[{

Cell[TextData[StyleBox["Simulation Set Up",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825084075731982*^9, 3.8250840893431263`*^9}, {
  3.825084585977352*^9, 3.8250845948215303`*^9}, {3.952011634896373*^9, 
  3.95201166277954*^9}},ExpressionUUID->"5e0cf91e-e5a0-48cb-947f-\
fcc90510233b"],

Cell[TextData[{
 StyleBox["In this section, we define the simulation domain by specifying the \
spatial extent (",
  FontSize->16],
 StyleBox["L",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[") and the number of grid points (",
  FontSize->16],
 StyleBox["numgrid",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["), then compute the spatial grid (",
  FontSize->16],
 StyleBox["x",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[") and its spacing (",
  FontSize->16],
 StyleBox["dx",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["). This discrete spatial grid is the foundation for implementing \
the finite-difference method to approximate spatial derivatives in the TDSE. \
One can change the parameter of the simulation to experiment:",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.825084741311521*^9, 3.825084777749395*^9}, {
   3.951993324695115*^9, 3.951993327410163*^9}, 3.952011675687488*^9, {
   3.952013102011574*^9, 3.952013106692822*^9}, {3.952339498096917*^9, 
   3.9523395071947613`*^9}},ExpressionUUID->"0bc7e6f4-3c78-4a22-823b-\
b23be9cbebe7"],

Cell[CellGroupData[{

Cell["Simulation Display Options:", "Subsubsection",
 CellChangeTimes->{{3.825084819684965*^9, 3.8250848269915943`*^9}, 
   3.952011690019055*^9},ExpressionUUID->"3edc9f14-25b7-448e-8fb8-\
380b91ea581c"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "simulation", " ", "domain", " ", 
     "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"L", "=", "500"}], ";"}], 
    "                                     ", 
    RowBox[{"(*", 
     RowBox[{
     "Total", " ", "length", " ", "of", " ", "the", " ", "simulation", " ", 
      "region", " ", "in", " ", "nm"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"numgrid", "=", "1000"}], ";"}], "                 ", "    ", 
    RowBox[{"(*", 
     RowBox[{
     "Total", " ", "number", " ", "of", " ", "spatial", " ", "grid", " ", 
      "points"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"ntimestep", "=", "15000"}], ";"}], "              ", 
    RowBox[{"(*", 
     RowBox[{
     "Total", " ", "number", " ", "of", " ", "time", " ", "steps", " ", "to", 
      " ", "simulate"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"framestep", "=", "100"}], ";"}], "                   ", 
    RowBox[{"(*", 
     RowBox[{"Frequency", " ", 
      RowBox[{"(", 
       RowBox[{"in", " ", "time", " ", "steps"}], ")"}], " ", "at", " ", 
      "which", " ", "frames", " ", "are", " ", "captured", " ", "for", " ", 
      "animation"}], "*)"}]}]}],
  FontSize->14]], "Input",
