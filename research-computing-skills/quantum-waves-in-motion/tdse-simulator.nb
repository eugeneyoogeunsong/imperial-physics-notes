Cell[CellGroupData[{

Cell[TextData[StyleBox["Numerical Wave Propagation via FDTD Method",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.8251485371976767`*^9, 3.82514854919247*^9}, {
  3.952011747312974*^9, 3.952011747971097*^9}, {3.952011795182362*^9, 
  3.952011796955278*^9}},ExpressionUUID->"605f8979-4df5-4a74-8214-\
f26fedf7a2b3"],

Cell[TextData[{
 StyleBox["The FDTD constants and time step are defined by setting ",
  FontSize->16],
 StyleBox["c1",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" to determine the free-particle propagation speed, calculating ",
  FontSize->16],
 StyleBox["dt",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" from ",
  FontSize->16],
 StyleBox["c1",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[", the electron mass, ",
  FontSize->16],
 StyleBox["dx",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[", and hbar for proper time scaling, and defining ",
  FontSize->16],
 StyleBox["c2",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" to scale the influence of the potential. The finite-difference \
propagation updates the wavefunction\[CloseCurlyQuote]s real and imaginary \
parts using central differences, thereby modeling both kinetic and potential \
effects.  Overall, the objective is to simulate the wave-packet\
\[CloseCurlyQuote]s time evolution using the FDTD method while capturing key \
quantum phenomena such as tunneling and reflection.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.82514855546348*^9, 3.8251485972118187`*^9}, 
   3.952022466752527*^9, {3.952264683959022*^9, 3.952264702537258*^9}, 
   3.952273933888054*^9},ExpressionUUID->"cadb6a55-ce1f-45d4-93fc-\
e58ec19cac64"],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "FDTD", " ", "constants", " ", "for", " ", "wave", " ", 
     "propagation"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"c1", "=", 
      RowBox[{"1", "/", "10"}]}], ";"}], 
    "                                                            ", "  ", 
    "  ", "  ", "  ", "  ", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{
       "Constant", " ", "controlling", " ", "the", " ", "free", " ", 
        "particle"}], "\[CloseCurlyQuote]"}], "s", " ", "propagation", " ", 
      "speed"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"dt", "=", 
      RowBox[{"c1", "*", "2", "*", "me", "*", 
       RowBox[{"(", 
        RowBox[{"dx", "^", "2"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"10", "^", "11"}], "/", "hbar"}], ")"}]}]}], ";"}], 
    "         ", "  ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Compute", " ", "the", " ", "time", " ", "step", " ", "based", " ", 
       "on", " ", "c1"}], ",", " ", 
      RowBox[{"electron", " ", "mass"}], ",", " ", 
      RowBox[{"grid", " ", "spacing"}], ",", " ", 
      RowBox[{"and", " ", "hbar"}]}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"c2", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"e", "*", "dt", "*", "1000"}], ")"}], "/", "hbar"}]}], ";"}], 
    "                                         ", 
    RowBox[{"(*", 
     RowBox[{
     "Constant", " ", "that", " ", "scales", " ", "the", " ", "influence", " ",
       "of", " ", "the", " ", "potential", " ", "on", " ", "the", " ", "wave",
       " ", "propagation"}], "*)"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"c1", "=", 
       RowBox[{"1", "/", "5"}]}], ";", "                                  ", 
      RowBox[{"(*", 
       RowBox[{"Increase", " ", "c1", " ", "to", " ", 
        RowBox[{"1", "/", "5"}], " ", "to", " ", "speed", " ", "up", " ", 
        "free", " ", "particle", " ", "propagation"}], "*)"}], "\n", 
      RowBox[{"dt", "=", 
       RowBox[{"c1", "*", "2", "*", "me", "*", 
        RowBox[{
         RowBox[{"dx", "^", "2"}], "/", "hbar"}]}]}], ";", "              ", 
      "  ", "  ", "  ", "  ", 
      RowBox[{"(*", 
       RowBox[{
       "Recalculate", " ", "dt", " ", "based", " ", "on", " ", "the", " ", 
        "new", " ", "c1"}], "*)"}], "\n", 
      RowBox[{"c2", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"e", "*", "dt"}], ")"}], "/", "hbar"}]}], ";"}], 
     "                            ", 
     RowBox[{"(*", 
      RowBox[{
      "c2", " ", "automatically", " ", "scales", " ", "with", " ", "the", " ",
        "new", " ", "dt"}], "*)"}], "\n", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c1 = \>\"", ",", "c1"}], "]"}], ";"}], "\n", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<dt = \>\"", ",", "dt"}], "]"}], ";"}], "\n", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<c2 = \>\"", ",", "c2"}], "]"}], ";"}], "\n"}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.825152062079685*^9, 3.825152240191801*^9}, 
