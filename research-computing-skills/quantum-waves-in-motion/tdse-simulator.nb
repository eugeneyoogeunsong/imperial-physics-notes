Cell[CellGroupData[{

Cell[TextData[StyleBox["Step Potential Well",
 FontSize->36]], "Section",
 CellChangeTimes->{{3.825588018836829*^9, 3.8255880278357553`*^9}, {
  3.82559280574998*^9, 3.8255928129441957`*^9}, {3.82559360578863*^9, 
  3.825593610417406*^9}},ExpressionUUID->"b3590bf4-589f-4322-8ea7-\
9f598a6f1c22"],

Cell[TextData[{
 StyleBox["In this simulation, we investigate the behavior of ",
  FontSize->16],
 StyleBox["a bound particle",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" as it encounters a ",
  FontSize->16],
 StyleBox["step potential barrier",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[". \n\nTo simulate a scenario where a freely traveling wave packet \
interacts with a barrier, we ",
  FontSize->16],
 StyleBox["shift the step potential to the",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSize->16],
 StyleBox["right",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[", placing it directly in the path of the particle. This \
configuration allows us to study phenomena such as reflection, transmission, \
and quantum tunneling at a sharp potential step.",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.82559282045891*^9, 3.825592904136395*^9}, {
  3.82559293489954*^9, 3.825592934907589*^9}, {3.825593428214449*^9, 
  3.825593452589876*^9}, {3.82559361912503*^9, 3.825593669219612*^9}, {
  3.825593699614921*^9, 3.8255937002346973`*^9}, {3.825604463163863*^9, 
  3.8256045108014307`*^9}, {3.9522702187468233`*^9, 
  3.952270233843602*^9}},ExpressionUUID->"03668589-a03d-4178-8365-\
f63a2f8e1619"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Configure", " ", "the", " ", "potential", " ", "for", " ", "the", " ", 
    "step", " ", "potential", " ", 
    RowBox[{"scenario", "."}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"shift", "=", "150"}], ";"}], "\[IndentingNewLine]", "  ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Shift", " ", "the", " ", "potential", " ", "well", " ", "to", " ", 
      "the", " ", "right", " ", "by", " ", "approximately", " ", "150", " ", 
      "nm", " ", "along", " ", "the", " ", "x"}], "-", 
     RowBox[{
      RowBox[{"axis", ".", " ", "This"}], " ", "positions", " ", "the", " ", 
      "step", " ", "barrier", " ", "in", " ", "front", " ", "of", " ", "the", 
      " ", "propagating", " ", "wave", " ", 
      RowBox[{"packet", "."}]}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wellwidth", "=", "100"}], ";"}], "     "}]}]], "Input",
 CellChangeTimes->{{3.825604512355577*^9, 3.8256045223494673`*^9}, {
   3.8256046563001747`*^9, 3.825604758895774*^9}, {3.825654921918591*^9, 
   3.8256549493999977`*^9}, {3.8256549871476603`*^9, 3.825654996706081*^9}, {
   3.952270421702321*^9, 3.952270431837934*^9}, {3.952270592170019*^9, 
   3.9522706384216213`*^9}, 3.952291215663526*^9, {3.9525053055888577`*^9, 
   3.952505318370245*^9}},
 FontSize->14,
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"9120a8ad-4d77-4763-96f7-50d6c61a5424"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Retrieve", " ", "the", " ", "step", " ", "potential", " ", "from", " ", 
    "the", " ", "potential", " ", 
    RowBox[{"library", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"potentialStep", " ", "=", 
    RowBox[{"choosePotential", "[", "\"\<step\>\"", "]"}]}], ";"}]}]], "Input",\

 CellChangeTimes->{{3.825588202195941*^9, 3.825588213978767*^9}, {
   3.825588256414103*^9, 3.825588257812793*^9}, {3.825592603559998*^9, 
   3.8255926044404507`*^9}, {3.825593480322283*^9, 3.825593504753121*^9}, {
