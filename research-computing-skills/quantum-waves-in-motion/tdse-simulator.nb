Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "wavepacket", " ", "characteristics"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"wavelength", "=", "30"}], ";"}], 
    "                                   ", "   ", 
    RowBox[{"(*", 
     RowBox[{
     "Wavelength", " ", "of", " ", "the", " ", "wavepacket", " ", "in", " ", 
      "nm"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"s", "=", "20"}], ";"}], 
    "                                                           ", 
    RowBox[{"(*", 
     RowBox[{"Characteristic", " ", "width", " ", 
      RowBox[{"(", 
       RowBox[{"standard", " ", "deviation"}], ")"}], " ", "of", " ", "the", " ",
       "wavepacket"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"wavecentre", "=", "250"}], ";"}], 
    "                                    ", 
    RowBox[{"(*", 
     RowBox[{
     "Central", " ", "position", " ", "of", " ", "the", " ", "wavepacket", " ",
       "in", " ", "nm"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"wavecentreindex", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"Round", "[", "x", "]"}], ",", "wavecentre"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "         ", 
    "\[IndentingNewLine]", "\t      \t      \t      \t                 ", 
    RowBox[{"(*", 
     RowBox[{
     "Determine", " ", "the", " ", "grid", " ", "index", " ", "closest", " ", 
      "to", " ", "the", " ", "wavepacket", " ", "center"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"k", "=", 
      RowBox[{"2", "*", 
       RowBox[{"Pi", "/", "wavelength"}]}]}], ";"}], "\[IndentingNewLine]", 
    "  ", " ", "                            ", "  ", "  ", "  ", "  ", "  ", 
    "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", "  ", 
    "  ", "  ", "  ", " ", 
    RowBox[{"(*", 
     RowBox[{
     "Calculate", " ", "the", " ", "wave", " ", "number", " ", "based", " ", 
      "on", " ", "the", " ", "wavelength"}], "*)"}]}]}],
  FontSize->14]], "Input",
 CellChangeTimes->{{3.8250846271260843`*^9, 3.8250846589999037`*^9}, {
   3.825091739340645*^9, 3.825091802302657*^9}, {3.8250920325404253`*^9, 
   3.825092033308013*^9}, {3.825092071634371*^9, 3.8250920726232557`*^9}, 
   3.8250924989922123`*^9, {3.825092583019886*^9, 3.825092586559683*^9}, {
   3.825092624400504*^9, 3.825092640013155*^9}, {3.825092686045269*^9, 
   3.8250928210765123`*^9}, {3.825093024447071*^9, 3.8250931090141582`*^9}, 
   3.825093168169798*^9, {3.825093227023883*^9, 3.825093294879318*^9}, {
   3.825093367906664*^9, 3.825093435830847*^9}, {3.825093533606016*^9, 
   3.825093562117766*^9}, {3.825093621378903*^9, 3.8250936401176233`*^9}, {
   3.825094194575144*^9, 3.825094206310944*^9}, 3.8251386947823563`*^9, {
   3.825435861235098*^9, 3.825435861793934*^9}, {3.825589925598731*^9, 
   3.825589951967174*^9}, {3.825590042192834*^9, 3.825590044105289*^9}, {
   3.8255907909668283`*^9, 3.8255908168817673`*^9}, 3.82559229933357*^9, {
   3.825659306513363*^9, 3.8256593352651863`*^9}, {3.952012863412039*^9, 
