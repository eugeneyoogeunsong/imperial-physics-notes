  3.951094035252822*^9}},ExpressionUUID->"dfe9c44b-4140-497c-8bdd-\
b94661bc530a"],

Cell[TextData[{
 StyleBox["Written by Yoogeun Song. This mini-project was \
conducted from March 11 to April 1, 2025.",
  FontSize->24,
  FontWeight->"Bold",
  FontColor->GrayLevel[0]],
 StyleBox[" ",
  FontColor->GrayLevel[0]]
}], "Subtitle",
 CellChangeTimes->{{3.8250709518981447`*^9, 3.8250709759955063`*^9}, {
  3.825082068444275*^9, 3.82508207728728*^9}, {3.8250822135724983`*^9, 
  3.8250822346276817`*^9}, {3.951094001226474*^9, 3.951094035252822*^9}, {
  3.9525106497706547`*^9, 3.952510654641932*^9}, {3.952518188110849*^9, 
